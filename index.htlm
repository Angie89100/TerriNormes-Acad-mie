<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>TerriNormes Académie V10</title><style>*{box-sizing:border-box}body{margin:0;font:16px system-ui;background:#f2f5f8;color:#142c42}header{background:#102c47;color:white;padding:28px 5%}header a{color:#b9e6df}nav{display:flex;flex-wrap:wrap;gap:7px;background:white;padding:15px;position:sticky;top:0;z-index:1;border-bottom:1px solid #ccd8e2}button,select,input,textarea{font:inherit}button,select{padding:10px;border:1px solid #a9bac8;border-radius:7px;background:white;color:#15344e;cursor:pointer}button.active,button.primary{background:#08796f;color:white}main{max-width:1080px;margin:auto;padding:20px}article,section{padding:20px;background:white;border:1px solid #d5dfe7;border-radius:12px;margin:12px 0}h2,h3{margin-top:0}a{color:#235f9d}textarea{width:100%;min-height:100px;padding:10px;border:1px solid #a9bac8;border-radius:6px}label{display:block;margin:12px 0}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:10px;border-bottom:1px solid #d5dfe7}details{background:#eaf2f4;padding:12px;border-radius:8px;margin:10px 0}summary{cursor:pointer;font-weight:bold}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}output{font-size:1.4rem;font-weight:bold}footer{padding:20px;text-align:center;color:#52677c}input[type=number]{width:110px;padding:8px}@media print{nav,button,header a{display:none}article{break-inside:avoid}}.flowchart{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:18px 0;padding:12px;background:#edf4f7;border-radius:8px}.node{padding:9px 12px;border:1px solid #86a9b5;border-radius:6px;background:white;font-weight:600}.arrow{color:#08796f;font-weight:bold;font-size:1.4em}h4{color:#08796f;margin-bottom:5px}@media(max-width:600px){.flowchart{flex-direction:column;align-items:stretch}.arrow{text-align:center;transform:rotate(90deg)}.node{text-align:center}}.noticeflow{display:grid;gap:18px;max-width:650px;margin:20px auto}.noticeflow div{position:relative;background:#e2eef2;border:1px solid #aac5ce;border-radius:8px;padding:12px;text-align:center;font-weight:600}.noticeflow div:not(:last-child):after{content:"↓";position:absolute;bottom:-22px;left:50%;color:#08796f}progress{accent-color:#08796f}.schema-visual{margin:14px 0;padding:12px;background:#f7fbfc;border:1px solid #d5e3ea;border-radius:10px}.schema-visual svg{width:100%;height:auto;display:block}.schema-caption{font-size:.95rem;color:#52677c;margin-top:8px}.schema-example{margin-top:10px;padding:10px 12px;background:#eef6f7;border-left:4px solid #08796f;border-radius:8px}.pillrow{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0}.pill{background:#eef6f7;border:1px solid #b7ccd6;border-radius:999px;padding:6px 10px;font-size:.92rem}.legend{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;margin-top:10px}.legend div{background:white;border:1px solid #d5dfe7;border-radius:8px;padding:8px 10px}.examworkspace{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:14px}.examworkspace textarea{min-height:180px}.examworkspace #officialCopy{min-height:420px}#officialClock{font-size:2rem;color:#08796f;font-variant-numeric:tabular-nums}.deep{border:1px solid #a9c8cc;background:#f1f8f8;border-radius:10px;padding:16px;margin:14px 0}.pitfall{border-left:4px solid #b87c29;padding:10px;background:#fff7e9}.deep button{margin:4px 0}#coachResult{padding:12px;background:#edf4f7;margin-top:12px;border-radius:8px}.jflow,.jdates{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.jflow span{background:#102c47;color:white;padding:10px 15px;border-radius:8px}.jdates button{flex:1;min-width:95px}.jdates .jdone{background:#d9eee4;border-color:#39865d}.jdates .jlate{background:#fff0e9;border-color:#b75b39}.jdates .jtoday{background:#e0effa;border-color:#3677a8}.jdates button:disabled{opacity:.65;cursor:default}.jtask{display:flex;flex-wrap:wrap;gap:12px;align-items:center;border-bottom:1px solid #d5dfe7;padding:10px 0}.jtask b{flex:1;min-width:180px}@media print{.jdates button{display:block;color:#102c47}} .stepintro{border-left:5px solid #08796f}.stepcard{border-left:4px solid #235f9d;scroll-margin-top:150px}.stepdone{border-left-color:#08796f;background:#f2faf6}.stephead{display:flex;gap:14px;align-items:center}.stephead h3{margin:0}.stepnum{background:#102c47;color:white;border-radius:50%;width:42px;height:42px;display:grid;place-items:center;flex-shrink:0;font-weight:700}.stepcriterion{background:#edf5f4;padding:12px;border-radius:8px}.stepintro select{max-width:100%}article{scroll-margin-top:150px}.masterbox{border-left:4px solid #08796f;background:#f7fbfc;padding:16px;margin:14px 0;border-radius:8px}.masterbox dt{font-weight:700;color:#173b57}.masterbox dd{margin:4px 0 12px}progress{width:100%;max-width:500px}</style></head><body><header><a href="https://angie89100.github.io/TerriNormes/">← Référentiel et veille TerriNormes</a><h1>TerriNormes Académie V10</h1><p>Préparation aux concours internes · B / A / A+</p><select id="level" aria-label="Concours"><option value="B">B — Rédacteur principal de 2e classe</option><option value="A">A — Attaché territorial, administration générale</option><option value="P">A+ — Administrateur territorial</option></select></header><nav id="nav"></nav><main id="main"></main><footer>Module pédagogique indépendant · Stockage local dans le navigateur · Vérifier les textes et cadrages officiels de la session.</footer><script>
'use strict';const $=id=>document.getElementById(id), exams={B:[['Rapport avec propositions',3,1],['Questions professionnelles',3,1]],A:[['Rapport avec solutions opérationnelles',4,4]],P:[['Économie : synthèse et propositions',4,3],['Droit public : synthèse et propositions',4,3],['Cas professionnel',4,5],['Société contemporaine',5,3],['Finances publiques',3,2]]},orals={B:[['Entretien professionnel',20,1]],A:[['Entretien professionnel',25,5]],P:[['Entretien professionnel',30,5],['Mise en situation collective',45,2],['Questions sociales ou européennes',30,3],['Droit et gestion des collectivités',30,3]]};
const lessons=[['Droit public','Vérifier compétence, procédure, fondement, motifs et proportionnalité.','Une décision restrictive doit être justifiée par son objectif et les circonstances.','https://www.legifrance.gouv.fr/'],['Économie','Distinguer croissance réelle, inflation, emploi et pouvoir d’achat.','Une hausse des prix réduit la capacité d’investissement à budget constant.','https://www.insee.fr/'],['Finances publiques','Épargne brute = recettes réelles de fonctionnement moins dépenses réelles de fonctionnement. Épargne nette = épargne brute moins remboursement du capital.','12 M€ de recettes, 10 M€ de dépenses, 0,8 M€ de capital : 2 M€ brute et 1,2 M€ nette.','https://www.collectivites-locales.gouv.fr/'],['RH et GPEC','Cartographier emplois et compétences, anticiper les écarts, choisir formation, mobilité et recrutement.','Analyser les causes de l’absentéisme avant de réorganiser.','https://www.cnfpt.fr/'],['Questions sociales','Étudier accès aux droits, non-recours, coordination des acteurs et compétences.','Un guichet multicanal associe accueil physique et médiation numérique.','https://www.vie-publique.fr/'],['Société contemporaine','Problématiser, confronter arguments et objections, illustrer et nuancer.','Le numérique améliore-t-il nécessairement l’égalité devant le service public ?','https://www.vie-publique.fr/'],['Gouvernance','Les élus définissent les orientations ; les services préparent et mettent en œuvre les décisions.','Présenter trois scénarios chiffrés et leurs risques avant arbitrage.','https://www.collectivites-locales.gouv.fr/'],['Numérique et données','Identifier finalité, base juridique, minimisation, sécurité et responsabilités.','Associer DPO et DSI avant de déployer une IA générative.','https://www.cnil.fr/'],['Commande publique','Définir le besoin et respecter liberté d’accès, égalité de traitement et transparence.','Comparer coût global, qualité et risques de dépendance.','https://www.economie.gouv.fr/daj'],['Union européenne','Distinguer institutions, compétences, règlements et directives.','Identifier les conséquences des règles européennes pour les achats publics.','https://european-union.europa.eu/index_fr']];
const quiz=[['Épargne brute ?',['RRF − DRF','Dette − investissements','Population − dépenses'],0,'Elle mesure le solde du fonctionnement.'],['Priorité avant un projet IA ?',['Acheter','Identifier usages et risques','Supprimer les contrôles'],1,'Le diagnostic précède le choix.'],['GPEC ?',['Anticiper les écarts de compétences','Supprimer les formations','Évaluer seulement les salaires'],0,'Elle relie emplois et stratégie.'],['Proposition opérationnelle ?',['Titre seul','Texte seul','Responsable, moyens, délai, indicateur'],2,'Une action doit être pilotable.'],['Synthèse ?',['Restituer les éléments utiles du dossier','Inventer des chiffres','Donner seulement son avis'],0,'Respecter la commande et le dossier.'],['Inflation ?',['Baisse des prix','Hausse générale et durable des prix','Hausse automatique des salaires'],1,'Elle affecte le pouvoir d’achat.'],['Non-recours ?',['Droit non mobilisé','Recours judiciaire','Sanction'],0,'Analyser les obstacles d’accès.'],['Indicateur de délai ?',['Nombre de bureaux','Durée réception-clôture','Budget total'],1,'Préciser le périmètre mesuré.'],['Arbitrage ?',['Moins cher systématiquement','Ignorer les risques','Comparer coûts, bénéfices et risques'],2,'Éclairer la décision.'],['Épargne nette ?',['Brute moins capital remboursé','Brute plus dette','Recettes moins population'],0,'Elle renseigne sur la capacité à financer les investissements.']];
const cases=[['IA générative','Le DGS demande un cadre sécurisé pour les usages de l’IA.','Données fictives : 40 % des agents interrogés utilisent une IA, aucune charte, budget pilote de 40 000 €.','I. Diagnostic des usages, risques et bénéfices. II. Charte, DPO/DSI, pilote, formation, évaluation à six mois.'],['Absentéisme','Proposer un plan de continuité et de prévention.','Données fictives : 12 % d’absentéisme, hausse des délais de 20 %, trois postes vacants.','I. Objectiver les causes. II. Comparer renfort, mutualisation, réorganisation ; dialogue social, prévention et suivi.'],['Budget','Préserver les services malgré une hausse des charges.','Données fictives : recettes 12 M€, dépenses 10 M€, hausse des charges 0,6 M€, capital remboursé 0,8 M€.','Épargne brute après choc : 1,4 M€ ; nette : 0,6 M€. Comparer économies, recettes et programmation des investissements.'],['Accès aux droits','Réduire le non-recours et les délais.','Données fictives : 25 % de dossiers incomplets, délai médian 15 jours.','Diagnostic des publics, accueil multicanal, simplification, expérimentation, mesure des délais et du non-recours.']];
let state;try{state=JSON.parse(localStorage.getItem('tnAcademieV1'))||{}}catch{state={}}state.done||={};state.drafts||={};state.results||=[];let level=state.level||'P',tab='Parcours guidé',timer;const tabs=['Accueil','Épreuves','Cours','Schémas','Méthodes','Fiches','QCM','Cas pratiques','Atelier rédaction','Oral','Simulateurs','Sources','Laboratoire','Concours blancs','Progression','Notices pédagogiques','Annales réelles','Parcours guidé','Diagnostic','Révisions actives','Coach rédaction','Planning méthode J','Étapes d’apprentissage','Maîtrise progressive','Glossaire','Carnet d’erreurs','Réponses commentées'];function save(){try{localStorage.setItem('tnAcademieV1',JSON.stringify(state))}catch{alert('Stockage local indisponible')}}function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function draft(k,t){return '<label>'+t+'<textarea data-key="'+level+k+'">'+esc(state.drafts[level+k])+'</textarea></label>'}function go(t){tab=t;clearInterval(timer);render()}$('level').value=level;$('level').onchange=e=>{level=e.target.value;state.level=level;save();go('Épreuves')};function table(rows,unit){return '<table><tr><th>Épreuve</th><th>Durée</th><th>Coef.</th></tr>'+rows.map(r=>'<tr><td>'+r[0]+'</td><td>'+r[1]+' '+unit+'</td><td>'+r[2]+'</td></tr>').join('')+'</table>'}
const courses=[["Institutions et décentralisation", "Comprendre qui décide et qui agit", "La décentralisation confie des compétences à des collectivités distinctes de l’État. La déconcentration organise les services territoriaux de l’État. Le conseil délibère ; l’exécutif prépare et exécute les décisions. Le préfet exerce notamment le contrôle de légalité.", "Élu → orientation → administration → mise en œuvre → évaluation", "Une commune veut créer un service : vérifier compétence, délibération, budget, organisation et contrôle.", "Identifier les acteurs et la procédure.", "Élaborer un calendrier et les responsabilités.", "Comparer portage communal, intercommunal et coopération en explicitant les critères.", "Qui vote le budget communal ?", "Le conseil municipal ; le maire prépare et exécute le budget.", "https://www.collectivites-locales.gouv.fr/"], ["Droit administratif", "Sécuriser une décision", "Examiner la compétence de l’auteur, les règles de procédure, la forme, les motifs et le but de la décision. Une mesure de police doit notamment être adaptée, nécessaire et proportionnée. Le contrôle juridictionnel dépend de la nature du litige.", "Compétence → procédure → motifs → proportionnalité → contrôle", "Face à des nuisances, une interdiction générale doit être comparée à des restrictions ciblées.", "Repérer le fondement et les pièces.", "Rédiger une note proposant une mesure adaptée.", "Arbitrer entre efficacité, libertés publiques et risque contentieux.", "Pourquoi éviter une interdiction générale sans diagnostic ?", "Elle peut être disproportionnée au regard des risques établis.", "https://www.conseil-etat.fr/"], ["Finances locales : fondamentaux", "Lire les équilibres financiers", "Les recettes et dépenses réelles de fonctionnement permettent de calculer l’épargne brute. L’épargne nette retranche le remboursement du capital de la dette. La capacité de désendettement rapporte l’encours de dette à l’épargne brute positive. Ces indicateurs éclairent les arbitrages sans constituer à eux seuls un diagnostic.", "RRF − DRF → épargne brute − capital remboursé → épargne nette", "RRF 12 M€, DRF 10 M€, capital 0,8 M€, dette 16 M€ : épargne brute 2 M€, nette 1,2 M€, désendettement 8 ans.", "Calculer les trois indicateurs.", "Expliquer l’effet d’une hausse des charges de 0,6 M€.", "Comparer trois scénarios pluriannuels et leurs effets sur le service.", "Après la hausse de 0,6 M€, quelle épargne nette ?", "12 − 10,6 − 0,8 = 0,6 M€ ; capacité de désendettement 16/1,4 ≈ 11,4 ans.", "https://www.collectivites-locales.gouv.fr/"], ["Économie générale", "Interpréter les indicateurs", "La croissance réelle mesure l’évolution de la production en volume. L’inflation mesure une hausse générale des prix. Une hausse nominale de revenu inférieure à l’inflation réduit le pouvoir d’achat. Les effets varient selon les ménages et les secteurs.", "Inflation → coûts → budget → arbitrages → effets sur les usagers", "Un marché de fournitures de 200 000 € augmente de 8 % : surcoût de 16 000 € à volume constant.", "Calculer le surcoût.", "Identifier les dépenses exposées et les leviers.", "Analyser les effets distributifs et les risques macroéconomiques.", "Un budget augmente de 2 % avec des prix en hausse de 5 % : évolue-t-il en volume ?", "Environ −2,86 % : 1,02/1,05 − 1.", "https://www.insee.fr/"], ["Commande publique", "Acheter avec méthode", "Définir le besoin, estimer sa valeur, déterminer la procédure applicable et respecter liberté d’accès, égalité de traitement et transparence. Le choix des critères doit être lié à l’objet du marché ou aux conditions d’exécution. Suivre ensuite l’exécution contractuelle.", "Besoin → estimation → procédure → attribution → exécution", "Pour un logiciel, comparer prix, maintenance, accessibilité, réversibilité et sécurité selon les critères annoncés.", "Établir une fiche de besoin.", "Préparer une analyse des risques et le suivi du marché.", "Arbitrer entre internalisation et externalisation selon le coût complet.", "Pourquoi ne pas fractionner artificiellement un achat ?", "Cela peut contourner les règles de publicité et de mise en concurrence.", "https://www.economie.gouv.fr/daj"], ["RH et GPEC", "Anticiper les besoins en compétences", "La GPEC (ou GPEEC dans le secteur public) rapproche les besoins futurs des ressources disponibles. Elle repose sur un état des lieux, des hypothèses, l’analyse des écarts et un plan d’action. Distinguer effectif, ETP, emploi et compétence.", "Cartographie → prévisions → écarts → actions → bilan", "Trois départs prévus et deux agents polyvalents : analyser les compétences critiques, organiser transmission et mobilité, puis décider du recrutement.", "Construire un tableau des compétences.", "Proposer un plan de formation et de mobilité.", "Arbitrer la trajectoire d’effectifs et la continuité du service.", "Deux agents à 50 % représentent combien d’ETP ?", "Un ETP, sous réserve de la convention de calcul utilisée.", "https://www.cnfpt.fr/"], ["Management et changement", "Conduire une transformation", "Un projet de changement commence par un diagnostic partagé. Définir une cible, identifier les acteurs, organiser la concertation, expérimenter et évaluer. Le management doit traiter les causes des difficultés plutôt que les seuls symptômes.", "Diagnostic → cible → concertation → pilote → généralisation", "Des délais augmentent de 20 % : analyser volumes, absences et processus avant de décider une réorganisation.", "Cartographier le circuit actuel.", "Construire une feuille de route avec responsables.", "Comparer les scénarios, intégrer dialogue social et soutenabilité financière.", "Quel indicateur associer à une baisse des délais ?", "La qualité ou le taux d’erreurs, pour éviter une amélioration artificielle.", "https://www.cnfpt.fr/"], ["Protection des données et IA", "Encadrer les usages numériques", "Le RGPD impose notamment finalité, licéité, minimisation, sécurité et responsabilité. L’usage d’une IA doit être examiné selon les données, la finalité, les risques et les obligations applicables. La validation humaine reste essentielle lorsque les résultats influencent une décision.", "Usage → données → risques → règles → contrôle humain", "Un agent veut résumer un dossier individuel : ne pas saisir de données identifiantes dans un service non autorisé ; solliciter DPO et DSI.", "Repérer les données à protéger.", "Proposer une charte et un pilote.", "Définir une gouvernance, des investissements et des conditions de généralisation.", "Une pseudonymisation suffit-elle à sortir du RGPD ?", "Non, une donnée pseudonymisée demeure personnelle si elle peut être réattribuée.", "https://www.cnil.fr/"], ["Politiques sociales", "Analyser les besoins et le non-recours", "Les politiques sociales mobilisent différents acteurs : État, départements, communes, CCAS et organismes sociaux. Le non-recours peut résulter de l’absence d’information, de difficultés de démarches ou de la non-réception du droit. Le diagnostic doit distinguer publics et territoires.", "Besoin → éligibilité → accès → accompagnement → résultat", "Un accueil numérique exclusif peut exclure certains publics : proposer un accompagnement et un canal physique.", "Identifier les interlocuteurs et les démarches.", "Organiser un parcours usager et des indicateurs.", "Arbitrer l’offre territoriale en fonction des besoins, coûts et effets sur les inégalités.", "Pourquoi mesurer les demandes abandonnées ?", "Pour identifier les obstacles invisibles dans les seuls dossiers terminés.", "https://www.vie-publique.fr/"], ["Évaluation des politiques publiques", "Distinguer activité et impact", "Les moyens sont les ressources ; les réalisations sont les prestations produites ; les résultats sont les changements observés ; les impacts sont les effets attribuables à l’action, dont l’établissement exige une méthode adaptée.", "Moyens → réalisations → résultats → impact", "Formation de 100 agents : nombre formé = réalisation ; baisse des erreurs = résultat ; attribution à la formation à vérifier.", "Définir un indicateur et sa source.", "Construire un tableau de bord avec référence initiale.", "Prévoir une méthode d’évaluation et examiner les effets indésirables.", "Pourquoi le nombre de formations ne suffit-il pas ?", "Il ne démontre pas une amélioration des pratiques.", "https://www.ccomptes.fr/"], ["Union européenne", "Comprendre les institutions", "Le Conseil européen fixe les grandes orientations ; la Commission propose généralement les textes et veille à leur application ; le Parlement et le Conseil de l’Union exercent des fonctions législatives selon les procédures. Un règlement est directement applicable ; une directive lie quant au résultat à atteindre.", "Orientation → proposition → adoption → application → contrôle", "Une règle européenne peut influencer les achats publics ou les financements territoriaux.", "Distinguer règlement et directive.", "Identifier les effets d’une règle sur les procédures.", "Analyser la cohérence entre politique locale et objectifs européens.", "Le Conseil européen et le Conseil de l’Union sont-ils identiques ?", "Non : composition et fonctions distinctes.", "https://european-union.europa.eu/index_fr"], ["Société contemporaine", "Construire une réflexion critique", "Une composition répond à une question par une thèse nuancée. Définir les termes, faire apparaître une tension, construire des arguments et mobiliser des exemples précis. Distinguer faits, valeurs et hypothèses.", "Définition → tension → problématique → arguments → conclusion", "Le numérique améliore-t-il l’égalité ? Il facilite certains accès mais peut créer des obstacles liés à l’équipement, aux compétences ou au handicap.", "Rédiger un paragraphe clair.", "Construire un plan équilibré.", "Confronter les arguments et formuler une position personnelle argumentée.", "Pourquoi éviter une liste d’avantages et d’inconvénients ?", "Elle ne construit pas nécessairement une démonstration répondant à la problématique.", "https://www.vie-publique.fr/"]];const methods=[["Note de synthèse et propositions", "Identifier le destinataire, le livrable et les verbes de commande. Lire le sommaire et classer les documents par idée. Construire un plan répondant à la demande, puis distinguer synthèse et propositions selon le cadrage.", "Pour un écrit de 4 h : 15 min commande, 65 min dossier, 25 min plan, 120 min rédaction, 15 min relecture.", "Le DGS demande un dispositif IA sécurisé : diagnostic des usages et risques ; stratégie d’encadrement et déploiement.", "Ne pas recopier les documents ni ajouter une référence juridique non vérifiée."], ["Cas professionnel", "Se placer dans la fonction demandée. Distinguer symptômes et causes. Comparer des options, recommander une solution et la décliner en actions avec moyens, calendrier et indicateurs.", "Diagnostic → options → arbitrage → plan d’action → évaluation", "Absentéisme : renfort temporaire, réorganisation ou mutualisation ; comparer coûts et continuité.", "Ne pas proposer une solution unique avant le diagnostic."], ["Composition", "Définir les mots du sujet, dégager une tension et proposer une problématique. Organiser les arguments, exemples et objections. Conclure en répondant à la question.", "Sujet → définitions → tension → problématique → démonstration", "La proximité est-elle toujours synonyme de qualité du service public ? Examiner accessibilité, expertise et coûts.", "Éviter le catalogue d’idées sans lien logique."], ["Questions courtes de finances", "Lire le verbe : calculer, définir, commenter. Poser la formule, donner le résultat avec son unité, interpréter et préciser les limites.", "Formule → calcul → unité → interprétation → limite", "Épargne brute 2 M€ ; dette 16 M€ : 8 ans de désendettement si épargne constante.", "Ne pas confondre capital remboursé et intérêts."], ["Entretien avec le jury", "Présenter des réalisations concrètes avec situation, tâche, action, résultat et recul. Expliquer les contraintes et la contribution personnelle.", "Situation → responsabilité → action → résultat → recul", "Un planning partagé : besoin initial, consultation, prototype, test, indicateurs, limites.", "Ne pas présenter une expérimentation comme un résultat déjà mesuré."]];
courses.push(...[["Responsabilité administrative", "Maîtriser responsabilité administrative", "Distinguer faute, dommage et causalité. La responsabilité sans faute existe dans certains régimes.", "Dommage → fait générateur → causalité → réparation", "Un usager chute sur un équipement public : recueillir les faits, vérifier entretien et signalisation, transmettre au service juridique.", "Identifier les éléments factuels.", "Organiser la procédure de traitement.", "Arbitrer prévention, assurance et investissement.", "Une faute suffit-elle à établir un droit à réparation ?", "Non : il faut notamment établir un préjudice réparable et un lien causal.", "https://www.conseil-etat.fr/"], ["Dialogue social", "Maîtriser dialogue social", "Le comité social territorial intervient sur les sujets collectifs relevant de ses attributions. Préparer le dossier, vérifier la consultation requise et assurer la traçabilité.", "Diagnostic → consultation → décision → suivi", "Une modification des horaires implique une analyse des impacts et des consultations applicables.", "Lister les impacts.", "Construire le calendrier de concertation.", "Arbitrer les scénarios en tenant compte du climat social.", "La consultation remplace-t-elle la décision ?", "Non, elle intervient selon les règles applicables avant la décision de l’autorité compétente.", "https://www.legifrance.gouv.fr/"], ["Gestion de crise", "Maîtriser gestion de crise", "La continuité exige une identification des activités critiques, des responsabilités, des moyens de secours et des modalités de communication.", "Alerte → qualification → décision → coordination → retour d’expérience", "Une panne informatique bloque les inscriptions scolaires : activer un mode dégradé et protéger les données.", "Appliquer le mode dégradé.", "Coordonner les services et le retour à la normale.", "Arbitrer les priorités et communiquer aux élus.", "Que faire après la crise ?", "Organiser un retour d’expérience et mettre à jour les procédures.", "https://www.ssi.gouv.fr/"], ["Transition écologique", "Maîtriser transition écologique", "Analyser les émissions, la vulnérabilité, les coûts et les effets sociaux ; distinguer atténuation et adaptation.", "Diagnostic → objectifs → actions → budget → mesure", "Rénovation énergétique des écoles : comparer investissement, économies et confort.", "Collecter les consommations.", "Programmer les travaux.", "Prioriser le portefeuille selon coût global et bénéfices.", "Quelle différence entre adaptation et atténuation ?", "L’adaptation réduit la vulnérabilité ; l’atténuation réduit les émissions.", "https://www.ademe.fr/"], ["Fiscalité et dette", "Maîtriser fiscalité et dette", "L’emprunt finance l’investissement et ne doit pas couvrir le remboursement du capital de la dette. Analyser les marges fiscales et la soutenabilité.", "Recettes → épargne → investissement → financement", "Dette de 18 M€ et épargne brute de 3 M€ : capacité de désendettement de 6 ans.", "Calculer le ratio.", "Comparer deux plans de financement.", "Tester une trajectoire pluriannuelle sous choc.", "Que mesure le ratio de désendettement ?", "Le nombre théorique d’années d’épargne brute nécessaire pour rembourser l’encours.", "https://www.collectivites-locales.gouv.fr/"], ["Analyse de données publiques", "Maîtriser analyse de données publiques", "Distinguer effectif, taux, variation relative et points de pourcentage. Contrôler le périmètre et la période.", "Source → contrôle → calcul → interprétation", "Un taux passe de 10 % à 12 % : +2 points, soit +20 % en relatif.", "Calculer la variation.", "Construire un tableau de bord.", "Évaluer les limites et le biais de sélection.", "Une corrélation démontre-t-elle une causalité ?", "Non, des facteurs tiers peuvent expliquer le lien.", "https://www.insee.fr/"], ["Déontologie", "Maîtriser déontologie", "Les agents publics sont soumis notamment aux obligations de dignité, impartialité, intégrité et probité. Prévenir les conflits d’intérêts et protéger les informations.", "Situation → risque → déport ou conseil → traçabilité", "Un agent participe à une décision concernant un proche : signaler le risque à la hiérarchie.", "Repérer le conflit.", "Organiser les procédures de prévention.", "Définir une gouvernance déontologique et ses contrôles.", "Un conflit potentiel doit-il être ignoré ?", "Non : le prévenir et solliciter les interlocuteurs compétents.", "https://www.legifrance.gouv.fr/"], ["Pilotage de projet", "Maîtriser pilotage de projet", "Définir périmètre, livrables, ressources, jalons, risques et gouvernance. Un indicateur doit être relié à un objectif.", "Cadrage → planification → exécution → contrôle → bilan", "Un portail famille : pilote sur un site, mesure des erreurs, formation, déploiement progressif.", "Tenir le planning.", "Coordonner le projet.", "Décider des jalons de poursuite ou d’arrêt.", "Quelle différence entre livrable et résultat ?", "Le livrable est produit ; le résultat décrit le changement obtenu.", "https://www.cnfpt.fr/"]]);quiz.push(...[["Une faute suffit-elle à établir un droit à réparation ?", ["Non : il faut notamment établir un préjudice réparable et un lien causal.", "Aucune analyse ni vérification n’est nécessaire.", "La décision relève systématiquement du préfet."], 0, "Non : il faut notamment établir un préjudice réparable et un lien causal."], ["La consultation remplace-t-elle la décision ?", ["La décision relève systématiquement du préfet.", "Non, elle intervient selon les règles applicables avant la décision de l’autorité compétente.", "Aucune analyse ni vérification n’est nécessaire."], 1, "Non, elle intervient selon les règles applicables avant la décision de l’autorité compétente."], ["Que faire après la crise ?", ["Aucune analyse ni vérification n’est nécessaire.", "La décision relève systématiquement du préfet.", "Organiser un retour d’expérience et mettre à jour les procédures."], 2, "Organiser un retour d’expérience et mettre à jour les procédures."], ["Quelle différence entre adaptation et atténuation ?", ["L’adaptation réduit la vulnérabilité ; l’atténuation réduit les émissions.", "Aucune analyse ni vérification n’est nécessaire.", "La décision relève systématiquement du préfet."], 0, "L’adaptation réduit la vulnérabilité ; l’atténuation réduit les émissions."], ["Que mesure le ratio de désendettement ?", ["La décision relève systématiquement du préfet.", "Le nombre théorique d’années d’épargne brute nécessaire pour rembourser l’encours.", "Aucune analyse ni vérification n’est nécessaire."], 1, "Le nombre théorique d’années d’épargne brute nécessaire pour rembourser l’encours."], ["Une corrélation démontre-t-elle une causalité ?", ["Aucune analyse ni vérification n’est nécessaire.", "La décision relève systématiquement du préfet.", "Non, des facteurs tiers peuvent expliquer le lien."], 2, "Non, des facteurs tiers peuvent expliquer le lien."], ["Un conflit potentiel doit-il être ignoré ?", ["Non : le prévenir et solliciter les interlocuteurs compétents.", "Aucune analyse ni vérification n’est nécessaire.", "La décision relève systématiquement du préfet."], 0, "Non : le prévenir et solliciter les interlocuteurs compétents."], ["Quelle différence entre livrable et résultat ?", ["La décision relève systématiquement du préfet.", "Le livrable est produit ; le résultat décrit le changement obtenu.", "Aucune analyse ni vérification n’est nécessaire."], 1, "Le livrable est produit ; le résultat décrit le changement obtenu."], ["Un taux passe de 20 à 25 % : variation en points ?", ["25 points", "20 points", "5 points"], 2, "25 − 20 = 5 points."], ["Dette 15 M€, épargne brute 3 M€ : ratio ?", ["5 ans", "45 ans", "12 ans"], 0, "15 / 3 = 5 ans."], ["Quel document permet de tracer les responsabilités ?", ["Un organigramme seul", "Une matrice RACI", "Une liste de prix"], 1, "RACI distingue réalisation, responsabilité, consultation et information."], ["Une hausse nominale de 2 % avec inflation de 4 % implique approximativement…", ["Une hausse réelle de 6 %", "Aucun effet", "Une baisse réelle de 2 %"], 2, "Le pouvoir d’achat diminue approximativement de 2 %."], ["Qui vote le budget communal ?", ["Le conseil municipal", "Le DGS", "Le comptable public"], 0, "Le conseil délibère ; le maire prépare et exécute."], ["Le contrôle de légalité est exercé notamment par…", ["Le régisseur", "Le préfet", "Le DPO"], 1, "Le préfet contrôle les actes soumis à transmission."]]);
function flow(t){return '<div class="flowchart">'+t.split(' → ').map((v,i)=> (i?'<span class="arrow" aria-hidden="true">→</span>':'')+'<span class="node">'+esc(v)+'</span>').join('')+'</div>'}

function wrapText(t,n){const words=String(t).split(/\s+/);let lines=[''];for(const w of words){let cur=lines[lines.length-1];if((cur+' '+w).trim().length>n){lines.push(w)}else{lines[lines.length-1]=(cur+' '+w).trim()}}return lines}
function svgBox(x,y,w,h,fill,label,size=12){const lines=wrapText(label,18);const tsp=lines.map((ln,i)=>`<tspan x="${x+w/2}" dy="${i===0?0:14}">${esc(ln)}</tspan>`).join('');const start=y+h/2-((lines.length-1)*7);return `<rect x="${x}" y="${y}" rx="12" ry="12" width="${w}" height="${h}" fill="${fill}" stroke="#7ea2b4"/><text x="${x+w/2}" y="${start}" font-size="${size}" font-weight="700" text-anchor="middle" fill="#16364f">${tsp}</text>`}
function svgArrow(x1,y1,x2,y2){return `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#08796f" stroke-width="4" marker-end="url(#arr)"/>`}
function baseSvg(inner,w=860,h=270){return `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Schéma illustré"><defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#08796f"/></marker></defs><rect width="100%" height="100%" rx="18" fill="#fbfdfe"/>${inner}</svg>`}
function genericCourseVisual(title,schema,example){const parts=String(schema).split('→').map(s=>s.trim()).filter(Boolean).slice(0,5);const boxW=145,gap=22,startX=20,y=42;let inner=`<text x="20" y="24" font-size="18" font-weight="700" fill="#0f2d48">${esc(title)}</text>`;parts.forEach((p,i)=>{const x=startX+i*(boxW+gap);inner+=svgBox(x,y,boxW,54,['#e7f4f3','#eef4fb','#fff3e9','#edf7ef','#f6eefb'][i%5],p);if(i<parts.length-1)inner+=svgArrow(x+boxW,y+27,x+boxW+gap-6,y+27)});inner+=`<rect x="20" y="132" width="820" height="96" rx="14" fill="#eef6f7" stroke="#c7dbe3"/><text x="36" y="160" font-size="16" font-weight="700" fill="#0f2d48">Exemple visuel</text><text x="36" y="188" font-size="14" fill="#16364f">${esc(example)}</text><text x="36" y="210" font-size="13" fill="#52677c">Lis le schéma de gauche à droite, puis reformule le mécanisme avec tes mots.</text>`;return baseSvg(inner,860,245)}
function courseVisual(title,schema,example){if(title==='Institutions et décentralisation'){let inner=`<text x="20" y="24" font-size="18" font-weight="700" fill="#0f2d48">Institutions et décentralisation</text>`;const labels=['Élu','Orientation','Administration','Mise en œuvre','Évaluation'];labels.forEach((p,i)=>{const x=18+i*165;inner+=svgBox(x,42,140,54,['#e9f3fb','#e8f6f5','#fdf2e8','#edf7ef','#f3eefb'][i],p);if(i<labels.length-1)inner+=svgArrow(x+140,69,x+159,69)});const lower=['Compétence','Délibération','Budget','Organisation','Contrôle'];lower.forEach((p,i)=>{const x=18+i*165;inner+=svgBox(x,145,140,46,'#ffffff',p,11)});inner+=`<rect x="18" y="112" width="822" height="18" rx="9" fill="#dff0ee"/><text x="429" y="125" text-anchor="middle" font-size="12" font-weight="700" fill="#08796f">Création d’un service communal : vérifier chaque étape avant la mise en œuvre</text>`;return baseSvg(inner,860,205)}
if(title==='Finances locales : fondamentaux'){let inner=`<text x="20" y="24" font-size="18" font-weight="700" fill="#0f2d48">Finances locales : fondamentaux</text>`;inner+=svgBox(30,50,170,54,'#e9f3fb','Recettes de fonctionnement');inner+=svgBox(245,50,170,54,'#fdf2e8','Dépenses de fonctionnement');inner+=svgBox(460,50,150,54,'#e8f6f5','Épargne brute');inner+=svgBox(655,50,160,54,'#f3eefb','Épargne nette');inner+=svgArrow(200,77,239,77);inner+=`<text x="222" y="70" font-size="13" fill="#08796f">−</text>`;inner+=svgArrow(415,77,454,77);inner+=svgArrow(610,77,649,77);inner+=`<text x="630" y="69" font-size="12" fill="#08796f">− capital dette</text>`;inner+=`<rect x="30" y="132" width="785" height="88" rx="14" fill="#eef6f7" stroke="#c7dbe3"/><text x="46" y="158" font-size="16" font-weight="700" fill="#0f2d48">Exemple chiffré</text><text x="46" y="184" font-size="14" fill="#16364f">RRF 12 M€ − DRF 10 M€ = épargne brute 2 M€ ; puis 2 M€ − 0,8 M€ = épargne nette 1,2 M€.</text><text x="46" y="205" font-size="13" fill="#52677c">Question à se poser : une hausse des charges réduit-elle encore la capacité d’autofinancement ?</text>`;return baseSvg(inner,850,235)}
return genericCourseVisual(title,schema,example)}
const masterData=[["Décentralisation", "Transfert de compétences à des collectivités autonomes.", "Déconcentration", "Organisation territoriale des services de l’État.", "Le conseil vote les orientations et le budget ; le maire exécute les décisions. La commune n’est pas sous la tutelle du département. L’intercommunalité exerce les compétences transférées.", "Une commune veut ouvrir un accueil de proximité. Vérifier la compétence, étudier le besoin, chiffrer le coût, soumettre les décisions à l’autorité compétente et organiser le service.", "Une mutualisation peut diminuer les coûts mais éloigner les usagers ; comparer accessibilité, qualité et compétences juridiques.", "Comparer régie communale, mutualisation et coopération selon coûts complets, délais, accès et responsabilité. Recommander une expérimentation puis un bilan.", "Le préfet ne dirige pas les services municipaux.", "Qui délibère sur le budget communal ?", "Le conseil municipal."], ["Légalité externe", "Compétence, forme et procédure de l’acte.", "Légalité interne", "Conformité du contenu, des motifs et du but de l’acte.", "La légalité s’apprécie notamment au regard de l’autorité compétente, de la procédure et de la justification de la mesure. En matière de police, vérifier nécessité et proportionnalité.", "Des nuisances nocturnes justifient une étude des horaires et lieux concernés avant une restriction ciblée.", "Une mesure générale réduit parfois les nuisances mais peut porter une atteinte excessive aux libertés ; documenter les faits.", "Comparer médiation, restriction ciblée et interdiction plus large ; retenir la mesure adaptée aux faits, prévoir contrôle et réexamen.", "Une décision utile n’est pas nécessairement légale.", "Pourquoi documenter les nuisances avant un arrêté ?", "Pour établir les faits et apprécier la nécessité et la proportionnalité."], ["Épargne brute", "Recettes réelles de fonctionnement moins dépenses réelles de fonctionnement.", "Épargne nette", "Épargne brute moins remboursement du capital de la dette.", "Le fonctionnement dégage des ressources pour l’investissement. Une hausse durable des charges réduit l’autofinancement ; la dette doit être analysée sur plusieurs années.", "Recettes 15 M€, dépenses 12 M€, capital 1 M€ : brute 3 M€, nette 2 M€. Si les charges augmentent de 1 M€, la nette tombe à 1 M€.", "La diminution de l’épargne peut retarder des équipements ; distinguer dépenses récurrentes et exceptionnelles.", "Comparer économies ciblées, recettes et phasage du PPI ; chiffrer effets sur les services, dette et épargne sur trois ans.", "Un budget équilibré ne garantit pas une bonne santé financière.", "Avec 15 M€ de recettes, 13 M€ de dépenses et 1 M€ de capital, quelle épargne nette ?", "1 M€."], ["Inflation", "Hausse générale du niveau des prix.", "Croissance réelle", "Variation de la production en volume, hors effet des prix.", "Une hausse nominale n’est pas une hausse réelle. Le rapport des indices de valeur et de prix mesure l’évolution en volume.", "Budget de 100 000 € porté à 103 000 €, prix +5 % : 1,03/1,05 − 1 ≈ −1,90 % en volume.", "Les coûts ne progressent pas tous au même rythme. Identifier les marchés exposés et les publics fragiles.", "Construire trois hypothèses de prix, tester les effets sur les dépenses et protéger les prestations prioritaires.", "Soustraire les taux donne seulement une approximation.", "Un budget stable avec des prix en hausse de 10 % permet-il le même volume d’achat ?", "Non : environ 9,1 % de volume en moins."], ["Coût complet", "Coût d’acquisition, d’usage, de maintenance et de sortie.", "Mise en concurrence", "Organisation d’une compétition selon les règles applicables.", "Le besoin et sa valeur déterminent la procédure ; les critères annoncés structurent l’analyse et le suivi du contrat.", "Logiciel A : 30 k€ + 10 k€/an ; B : 45 k€ + 4 k€/an. Sur cinq ans : 80 k€ contre 65 k€, hors autres coûts.", "Le moins cher à l’achat peut coûter davantage à l’usage ; contrôler sécurité, qualité et réversibilité.", "Comparer coût global, internalisation, dépendance fournisseur et risques ; définir critères avant consultation.", "Le prix d’achat seul ne permet pas de choisir objectivement.", "Quel logiciel coûte moins sur cinq ans selon cet exemple ?", "B, 65 k€ contre 80 k€."], ["ETP", "Équivalent temps plein : mesure du volume de travail.", "GPEEC", "Gestion prévisionnelle des effectifs, emplois et compétences.", "Partir des missions, cartographier les ressources, projeter les besoins et traiter les écarts par formation, mobilité ou recrutement.", "Quatre agents à temps plein et deux à mi-temps : six personnes, cinq ETP. Deux départs exigent une analyse des compétences perdues.", "Un déficit de compétences n’est pas toujours un déficit d’effectif ; analyser charge et polyvalence.", "Établir une trajectoire de masse salariale, transmission des savoirs et mobilité, avec continuité et dialogue social.", "Effectif physique et ETP ne sont pas synonymes.", "Six personnes dont deux à mi-temps représentent combien d’ETP ?", "Cinq ETP."], ["Conduite du changement", "Accompagnement d’une transformation des pratiques.", "Délégation", "Attribution encadrée de responsabilités ou pouvoirs selon le contexte.", "Un changement réussi nécessite diagnostic, implication, expérimentation, formation et mesure des effets.", "Un nouveau planning réduit les délais de 10 à 7 jours mais double les erreurs ; former et ajuster le processus.", "Mesurer uniquement le délai masque les effets sur la qualité et la charge de travail.", "Comparer déploiement immédiat, pilote et maintien ; fixer des critères de poursuite avec les équipes.", "Une résistance peut révéler un risque réel et non un refus de principe.", "Quel indicateur compléterait le délai ?", "Le taux d’erreurs ou la qualité du service."], ["Minimisation", "Limiter les données personnelles à ce qui est nécessaire.", "DPO", "Délégué à la protection des données.", "Définir la finalité et la base juridique, limiter les données, encadrer les accès et évaluer les risques ; une AIPD peut être requise en cas de risque élevé.", "Un agent veut résumer des dossiers nominatifs avec un service IA public : ne pas y transmettre les données sans cadre autorisé ; tester sur données fictives.", "Une pseudonymisation ne garantit pas l’anonymat ; évaluer réidentification, conservation et transferts.", "Piloter une expérimentation avec DSI, DPO et métiers ; définir usages permis, contrôles, formation et critères d’arrêt.", "Une IA n’est pas une source juridique fiable par elle-même.", "Peut-on considérer toute donnée pseudonymisée comme anonyme ?", "Non."], ["Non-recours", "Situation où une personne éligible ne bénéficie pas d’un droit ou service.", "Accessibilité", "Possibilité effective d’accéder à un service.", "L’accès dépend de l’information, de la compréhension, des moyens et de la capacité à finaliser la démarche.", "Sur 100 demandes, 25 sont abandonnées ; identifier les causes par entretiens et analyse des étapes.", "Un taux de traitement élevé peut masquer des exclusions si seuls les dossiers finalisés sont comptés.", "Comparer guichet physique, médiation et démarches simplifiées ; mesurer accès selon les publics et coûts.", "Numériser ne garantit pas l’accès universel.", "Pourquoi compter les démarches abandonnées ?", "Pour détecter des obstacles à l’accès."], ["Efficacité", "Degré d’atteinte des objectifs.", "Efficience", "Rapport entre résultats obtenus et ressources utilisées.", "Distinguer moyens, activités, produits, résultats et impacts ; un indicateur isolé ne prouve pas un lien causal.", "100 agents formés : mesurer ensuite les erreurs avant/après et vérifier les facteurs extérieurs.", "Une baisse des erreurs peut aussi résulter d’un changement de logiciel ; comparer périodes et périmètres.", "Fixer une situation initiale, des cibles, des indicateurs de qualité et de coût, puis un bilan d’impact prudent.", "Le nombre de formations n’est pas une preuve d’efficacité.", "Quel indicateur mesure mieux l’effet d’une formation ?", "L’évolution des pratiques ou des erreurs, avec analyse du contexte."], ["Règlement européen", "Acte obligatoire dans tous ses éléments et directement applicable.", "Directive", "Acte liant les États membres quant au résultat à atteindre.", "Distinguer Commission, Parlement, Conseil de l’Union et Conseil européen ; identifier le type d’acte et ses effets.", "Une collectivité prépare un achat : vérifier les dispositions nationales transposant les directives et les règles européennes applicables.", "Une obligation européenne peut contraindre un projet local tout en ouvrant des financements.", "Cartographier obligations, calendriers, ressources et interlocuteurs ; organiser la veille.", "Conseil européen et Conseil de l’Union ne sont pas identiques.", "Qui définit les orientations politiques générales de l’UE ?", "Le Conseil européen."], ["Problématique", "Question centrale qui organise une démonstration.", "Contre-argument", "Objection permettant de nuancer une thèse.", "Définir les termes, relever une tension, construire des arguments et exemples, puis répondre à la question posée.", "Sujet : le numérique favorise-t-il l’égalité ? Il réduit certaines distances mais peut exclure les personnes sans accès ou compétences.", "Opposer progrès technique et accès réel ; distinguer les effets selon les publics.", "Défendre une réponse nuancée : le progrès dépend des conditions d’accès et de gouvernance ; illustrer et discuter les limites.", "Une succession d’opinions ne constitue pas une démonstration.", "Pourquoi définir les termes du sujet ?", "Pour délimiter la réflexion et éviter le hors-sujet."], ["Préjudice", "Dommage juridiquement réparable sous conditions.", "Causalité", "Lien entre le fait générateur et le dommage.", "Identifier le régime de responsabilité applicable, les faits, le préjudice et le lien causal ; certains régimes sont sans faute.", "Une chute près d’un équipement dégradé impose de préserver preuves, signalements, état d’entretien et circonstances.", "L’existence d’une faute ne suffit pas à établir toute responsabilité ; vérifier le régime et les causes concurrentes.", "Organiser traitement des réclamations, maintenance préventive, assurance et suivi des incidents.", "Une faute ne signifie pas automatiquement indemnisation.", "Quels éléments examiner outre la faute ?", "Le préjudice, le lien causal et le régime applicable."], ["CST", "Comité social territorial, instance consultative sur les questions collectives relevant de ses attributions.", "Concertation", "Échange organisé avec les acteurs concernés.", "Identifier les impacts d’un projet et les consultations obligatoires ; distinguer dialogue, avis et décision finale.", "Réorganisation des horaires : analyser charge, santé, continuité et contraintes, préparer le dossier de consultation applicable.", "Une consultation tardive peut fragiliser le projet ; les échanges doivent intervenir au bon moment.", "Comparer scénarios et impacts, prévoir calendrier de dialogue et suivi des engagements.", "Un avis ne se substitue pas à la décision de l’autorité compétente.", "Pourquoi anticiper la consultation ?", "Pour respecter les procédures et éclairer la décision."], ["PCA", "Plan de continuité d’activité.", "REX", "Retour d’expérience après un événement.", "Identifier les activités critiques, seuils d’alerte, responsables, solutions de secours et modalités de reprise.", "Une panne bloque les inscriptions : activer une procédure temporaire sécurisée, informer les familles et tracer les dossiers.", "Le mode dégradé peut créer des doublons ou exposer des données ; définir les contrôles.", "Prioriser les services essentiels, désigner responsables et communication, tester le PCA puis tirer les enseignements.", "Une reprise technique ne signifie pas que tous les dossiers sont réconciliés.", "Que faire après le retour à la normale ?", "Un retour d’expérience et une mise à jour du PCA."], ["Atténuation", "Réduction des émissions de gaz à effet de serre.", "Adaptation", "Réduction de la vulnérabilité aux effets climatiques.", "Évaluer émissions et risques, définir les actions et leurs coûts sur la durée, mesurer les effets sociaux.", "École exposée à la chaleur : ombrage, ventilation et isolation ; comparer confort, consommation et maintenance.", "Une action peut diminuer les émissions mais ne pas suffire à protéger les usagers lors d’une canicule.", "Prioriser les bâtiments selon vulnérabilité, coût complet, économies et bénéfices sanitaires.", "Atténuation et adaptation ne sont pas interchangeables.", "L’ombrage d’une cour vise principalement quel objectif ?", "L’adaptation aux fortes chaleurs."], ["Encours de dette", "Capital restant dû à une date.", "Capacité de désendettement", "Encours rapporté à l’épargne brute positive.", "L’emprunt finance l’investissement dans le respect des règles budgétaires ; la trajectoire dépend des recettes, charges et remboursements.", "Dette 24 M€, épargne brute 3 M€ : 8 ans. Si épargne 2 M€, le ratio passe à 12 ans à dette constante.", "Le ratio est théorique ; il ne tient pas compte seul des échéances, taux ou besoins futurs.", "Simuler choc de taux, baisse d’épargne et report d’investissement ; recommander un scénario soutenable.", "Un ratio bas ne dispense pas d’étudier les besoins d’investissement.", "Dette 24 M€ et épargne brute 2 M€ : quel ratio ?", "12 ans."], ["Point de pourcentage", "Différence arithmétique entre deux taux.", "Variation relative", "Écart divisé par la valeur de départ.", "Vérifier source, dénominateur, période et comparabilité avant tout calcul ; distinguer association et causalité.", "Un taux passe de 8 à 10 % : +2 points, +25 % en relatif.", "Une hausse du taux peut provenir d’une baisse du dénominateur ; examiner aussi les effectifs.", "Construire un tableau de bord avec définitions stables, contrôles qualité et limites d’interprétation.", "Deux points ne signifient pas deux pour cent de hausse relative.", "Un taux passe de 20 à 25 % : variation relative ?", "25 %."], ["Conflit d’intérêts", "Interférence entre intérêt public et intérêts publics ou privés susceptible d’influencer l’exercice indépendant des fonctions.", "Déport", "Abstention de participer à une décision selon les règles applicables.", "Repérer les situations, signaler le risque et appliquer les procédures de prévention ; solliciter les interlocuteurs compétents.", "Un agent intervient dans un dossier concernant un proche : signaler la situation et organiser le déport selon les règles.", "Même sans avantage obtenu, l’apparence de partialité peut nuire à la confiance.", "Former les agents, définir circuit de signalement et traçabilité proportionnée, vérifier l’effectivité des mesures.", "L’absence de profit personnel ne suffit pas à exclure un conflit.", "Que faire face à un risque de conflit ?", "Le signaler et appliquer les mesures de prévention adaptées."], ["Jalon", "Point de contrôle d’un projet.", "Livrable", "Produit concret remis à l’issue d’une étape.", "Définir objectif, périmètre, ressources, rôles, risques et critères de réussite avant le déploiement.", "Portail famille : tester sur un site, mesurer erreurs et temps de traitement, former puis décider de généraliser.", "Un livrable opérationnel ne garantit pas l’amélioration du service ; mesurer l’adoption et la qualité.", "Comparer pilote, déploiement direct et report ; prévoir jalons de décision, budget et plan de réversibilité.", "Respecter le calendrier ne prouve pas l’atteinte de l’objectif.", "Quelle différence entre livrable et résultat ?", "Le livrable est le produit, le résultat le changement obtenu."]];

const masterNames=['Découverte','Compréhension','Application','Analyse','Maîtrise stratégique'];
function masterStore(){if(!state.master10||typeof state.master10!=='object')state.master10={};return state.master10;}
function masterKey(i,j){return level+':'+i+':'+j}
function masterSelect(i){state.masterCourse=+i;save();render()}
function masterMark(i,j,ok){const k=masterKey(i,j),v=masterStore()[k]||{};masterStore()[k]={ok:!!ok,date:new Date().toISOString(),attempts:(v.attempts||0)+1};save();render()}
function masterExercise(i,j){const d=masterData[i],c=courses[i];return [[d[9],d[10]],['Explique le mécanisme sans notes, avec les deux notions du glossaire.',d[4]],['Résous la situation : '+c[4],d[5]],['Quels risques et limites identifies-tu ? Justifie ton analyse.',d[6]],['Propose un arbitrage, ses moyens et ses critères de réussite.',d[7]]][j]}
function masterCard(i){const d=masterData[i];return '<div class="masterbox"><h4>Chapitre 1 — Vocabulaire</h4><dl><dt>'+esc(d[0])+'</dt><dd>'+esc(d[1])+'</dd><dt>'+esc(d[2])+'</dt><dd>'+esc(d[3])+'</dd></dl><h4>Chapitre 2 — Mécanismes et causalité</h4><p>'+esc(d[4])+'</p><h4>Chapitre 3 — Exemple résolu</h4><p>'+esc(d[5])+'</p><h4>Chapitre 4 — Analyse des risques</h4><p>'+esc(d[6])+'</p><h4>Chapitre 5 — Arbitrage stratégique</h4><p>'+esc(d[7])+'</p><p class="pitfall"><b>Piège :</b> '+esc(d[8])+'</p><button onclick="masterOpen('+i+')">Travailler les cinq niveaux</button></div>'}
function masterOpen(i){state.masterCourse=i;save();go('Maîtrise progressive')}
function masterView(){let i=Math.max(0,Math.min(19,Number(state.masterCourse)||0)),store=masterStore(),total=Object.keys(store).filter(k=>k.startsWith(level+':')&&store[k].ok).length;return '<section><h3>De la connaissance à la décision</h3><p>Réponds sans consulter le corrigé, puis compare. Valide uniquement si tu peux expliquer la réponse avec tes mots. Les niveaux sont pédagogiques, pas des notes de jury.</p><p><b>'+total+'/100 niveaux validés pour ce concours</b></p><progress max="100" value="'+total+'"></progress><label>Cours <select onchange="masterSelect(this.value)">'+courses.map((c,n)=>'<option value="'+n+'" '+(n===i?'selected':'')+'>'+esc(c[0])+'</option>').join('')+'</select></label><button onclick="go(\'Cours\')">Revenir aux cours</button></section>'+masterNames.map((n,j)=>{let e=masterExercise(i,j),v=store[masterKey(i,j)];return '<article class="masterbox"><h3>Niveau '+(j+1)+' — '+n+'</h3><p>'+esc(e[0])+'</p>'+draft('master'+i+'-'+j,'Ma réponse sans notes')+'<details><summary>Révéler le corrigé indicatif</summary><p>'+esc(e[1])+'</p><p><b>Contrôle :</b> '+(j===0?'Réponse exacte et vocabulaire précis.':j===1?'Mécanisme expliqué et notions définies.':j===2?'Application aux faits et calculs ou étapes justifiés.':j===3?'Causes, risques et limites identifiés.':'Options comparées, choix motivé, moyens et évaluation.')+'</p></details><button onclick="masterMark('+i+','+j+',false)">À retravailler</button> <button class="primary" onclick="masterMark('+i+','+j+',true)">Acquis</button><p>'+(!v?'Non évalué':v.ok?'✓ Acquis':'À revoir')+' · '+(v?.attempts||0)+' tentative(s)</p></article>'}).join('')}
function glossaryView(){return '<section><p>40 définitions utiles pour comprendre et rédiger. Recherche un terme, puis reformule-le sans notes.</p><input id="search" placeholder="Rechercher un terme"></section>'+masterData.flatMap((d,i)=>[[d[0],d[1]],[d[2],d[3]]].map(x=>'<article data-search="'+esc(x.join(' '))+'"><h3>'+esc(x[0])+'</h3><p>'+esc(x[1])+'</p><button onclick="masterOpen('+i+')">Exercice associé</button></article>')).join('')}
function errorView(){let a=masterStore();return '<section><h3>Mes erreurs à corriger</h3><p>Les niveaux marqués « À retravailler » apparaissent ici. Note la cause de ton erreur, la bonne règle et une action de révision.</p></section>'+Object.entries(a).filter(([k,v])=>k.startsWith(level+':')&&!v.ok).map(([k,v])=>{let [,i,j]=k.split(':').map((x,n)=>n?+x:x);let e=masterExercise(i,j);return '<article><h3>'+esc(courses[i][0])+' — '+masterNames[j]+'</h3><p>'+esc(e[0])+'</p><details><summary>Correction</summary>'+esc(e[1])+'</details>'+draft('error'+i+'-'+j,'Cause de mon erreur et règle à retenir')+'<button onclick="masterOpen('+i+')">Refaire l’exercice</button></article>'}).join('')+'<section><h3>Notes personnelles</h3>'+draft('generalErrors','Erreurs récurrentes, vocabulaire, plan, calculs')+'</section>'}
function copyView(){return '<section><h3>Exemples pédagogiques commentés (non officiels)</h3><p>Compare les réponses avant de rédiger. Les liens des annales restent dans le module dédié.</p></section>'+masterData.map((d,i)=>'<article><h3>'+esc(courses[i][0])+'</h3><p><b>Réponse insuffisante :</b> '+esc(d[8])+'</p><p><b>Réponse structurée :</b> '+esc(d[4])+' '+esc(d[5])+' '+esc(d[6])+' '+esc(d[7])+'</p><p><b>Lecture du correcteur :</b> le mécanisme pose le cadre ; l’exemple démontre l’application ; l’analyse explicite les limites ; l’arbitrage rend la réponse opérationnelle. Adapte ces éléments à la commande et au dossier.</p>'+draft('copy10'+i,'Réécris un paragraphe adapté à une commande précise')+'</article>').join('')}

function courseView(){return '<p>20 cours progressifs, avec cinq chapitres d’approfondissement et cinq niveaux d’entraînement. Lis, applique, rédige puis vérifie ta réponse. Les exemples chiffrés sont fictifs.</p><label>Filtrer les cours <input id="search" placeholder="RH, finances, droit…"></label>'+courses.map((c,i)=>'<article data-search="'+esc(c.join(' '))+'"><h3>'+(i+1)+' — '+c[0]+'</h3><p class="muted">Objectif : '+c[1]+'</p><h4>À comprendre</h4><p>'+c[2]+'</p>'+pedCard(i)+masterCard(i)+'<h4>Schéma</h4><div class="schema-visual">'+courseVisual(c[0],c[3],c[4])+'<p class="schema-caption">'+c[3]+'</p><div class="schema-example"><b>Exemple concret :</b> '+c[4]+'</div></div><h4>Application '+(level==='P'?'A+':level)+'</h4><p>'+c[({B:5,A:6,P:7})[level]]+'</p>'+draft('course'+i,'Entraînement : '+c[8])+'<details><summary>Correction expliquée</summary><p>'+c[9]+'</p></details><a target="_blank" rel="noopener" href="'+c[10]+'">Approfondir auprès de la source officielle</a></article>').join('')}
function schemaView(){return '<p>Schémas de mémorisation : reformule chaque étape sans regarder le cours.</p>'+courses.map(c=>'<article><h3>'+c[0]+'</h3><div class="schema-visual">'+courseVisual(c[0],c[3],c[4])+'<p class="schema-caption"><b>Chaîne logique :</b> '+c[3]+'</p><div class="schema-example"><b>Exemple :</b> '+c[4]+'</div></div></article>').join('')+'<article><h3>Développer un argument</h3>'+flow('Affirmation → justification → exemple → conséquence → action → évaluation')+'<p><b>Exemple :</b> La formation seule ne suffit pas. Les agents doivent disposer de règles concrètes et de solutions autorisées ; une expérimentation encadrée limite les risques et permet de vérifier les effets avant généralisation.</p></article>'}
function methodView(){return methods.map((m,i)=>'<article><h3>'+m[0]+'</h3><p>'+m[1]+'</p>'+ (m[2].includes(' → ')?flow(m[2]):'<p><b>Temps indicatifs :</b> '+m[2]+'</p>')+'<p><b>Exemple :</b> '+m[3]+'</p><p><b>Piège :</b> '+m[4]+'</p>'+draft('method'+i,'À toi : rédige une réponse ou un plan en appliquant cette méthode.')+'</article>').join('')}

const officialExams=[{"id": "b2025r", "l": "B", "y": 2025, "t": "Rapport avec propositions", "m": 180, "coef": 1, "url": "https://www.cdg-aura.fr/sites/default/files/Annales/2025_c_red_p2_rapport.pdf", "src": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "review": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "info": "Sélectionner la session et l’épreuve dans les annales si le lien ouvre le catalogue."}, {"id": "b2025q", "l": "B", "y": 2025, "t": "Questions sur les collectivités territoriales", "m": 180, "coef": 1, "url": "https://www.cdg-aura.fr/sites/default/files/Annales/2025_c_red_p2_q_ct_int_3c.pdf", "src": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "review": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "info": "Sélectionner la session et l’épreuve dans les annales si le lien ouvre le catalogue."}, {"id": "b2023r", "l": "B", "y": 2023, "t": "Rapport avec propositions", "m": 180, "coef": 1, "url": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "src": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "review": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "info": "Sélectionner la session et l’épreuve dans les annales si le lien ouvre le catalogue."}, {"id": "b2023q", "l": "B", "y": 2023, "t": "Questions sur les collectivités territoriales", "m": 180, "coef": 1, "url": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "src": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "review": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "info": "Sélectionner la session et l’épreuve dans les annales si le lien ouvre le catalogue."}, {"id": "b2021r", "l": "B", "y": 2021, "t": "Rapport avec propositions", "m": 180, "coef": 1, "url": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "src": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "review": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "info": "Sélectionner la session et l’épreuve dans les annales si le lien ouvre le catalogue."}, {"id": "b2021q", "l": "B", "y": 2021, "t": "Questions sur les collectivités territoriales", "m": 180, "coef": 1, "url": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "src": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "review": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "info": "Sélectionner la session et l’épreuve dans les annales si le lien ouvre le catalogue."}, {"id": "b2019r", "l": "B", "y": 2019, "t": "Rapport avec propositions", "m": 180, "coef": 1, "url": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "src": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "review": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "info": "Sélectionner la session et l’épreuve dans les annales si le lien ouvre le catalogue."}, {"id": "b2019q", "l": "B", "y": 2019, "t": "Questions sur les collectivités territoriales", "m": 180, "coef": 1, "url": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "src": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "review": "https://www.cdg-aura.fr/concours/redacteur-principal-2e-classe", "info": "Sélectionner la session et l’épreuve dans les annales si le lien ouvre le catalogue."}, {"id": "a2026", "l": "A", "y": 2026, "t": "Rapport — administration générale", "m": 240, "coef": 4, "url": "https://www.cdg-aura.fr/sites/default/files/Annales/2026_att_int_3c_sujet_rapport_ag.pdf", "src": "https://www.cdg-aura.fr/concours/attache", "review": "https://www.cdg-aura.fr/concours/attache", "info": "IA générative en collectivité — dossier de 38 pages"}, {"id": "a2024", "l": "A", "y": 2024, "t": "Rapport — administration générale", "m": 240, "coef": 4, "url": "https://www.cdg-aura.fr/concours/attache", "src": "https://www.cdg-aura.fr/concours/attache", "review": "https://www.cdg-aura.fr/concours/attache", "info": "Sélectionner le rapport interne administration générale dans la session indiquée."}, {"id": "a2022", "l": "A", "y": 2022, "t": "Rapport — administration générale", "m": 240, "coef": 4, "url": "https://www.cdg-aura.fr/concours/attache", "src": "https://www.cdg-aura.fr/concours/attache", "review": "https://www.cdg-aura.fr/concours/attache", "info": "Sélectionner le rapport interne administration générale dans la session indiquée."}, {"id": "a2020", "l": "A", "y": 2020, "t": "Rapport — administration générale", "m": 240, "coef": 4, "url": "https://www.cdg-aura.fr/concours/attache", "src": "https://www.cdg-aura.fr/concours/attache", "review": "https://www.cdg-aura.fr/concours/attache", "info": "Sélectionner le rapport interne administration générale dans la session indiquée."}, {"id": "p2025eco", "l": "P", "y": 2025, "t": "Économie", "m": 240, "coef": 3, "url": "https://www.cnfpt.fr/sites/default/files/document/1773310102/Epreuve%202.note%20de%20synth%C3%A8se%20%C3%A9conomie%20interne.pdf", "src": "https://www.cnfpt.fr/evoluer/preparations-aux-concours-examens-professionnels/decouvrir-concours-examens-professionnels/concours-dadministrateur-ou-administratrice-territorial/sujets-meilleures-copies-du-concours-dadministrateur-territorial/sujets-session-2025-du-concours", "review": "https://www.cnfpt.fr/evoluer/quels-sont-concours-examens-professionnels-organises-cnfpt/devenir-administrateur-ou-administratrice-territorial-concours/national", "info": "Chômage de longue durée et rôle des territoires"}, {"id": "p2025droit", "l": "P", "y": 2025, "t": "Droit public", "m": 240, "coef": 3, "url": "https://www.cnfpt.fr/evoluer/preparations-aux-concours-examens-professionnels/decouvrir-concours-examens-professionnels/concours-dadministrateur-ou-administratrice-territorial/sujets-meilleures-copies-du-concours-dadministrateur-territorial/sujets-session-2025-du-concours", "src": "https://www.cnfpt.fr/evoluer/preparations-a