es-copies-du-concours-dadministrateur-territorial/sujets-session-2025-du-concours", "review": "https://www.cnfpt.fr/evoluer/quels-sont-concours-examens-professionnels-organises-cnfpt/devenir-administrateur-ou-administratrice-territorial-concours/national", "info": "Choisir le document correspondant à cette épreuve sur la page officielle."}, {"id": "p2024eco", "l": "P", "y": 2024, "t": "Économie", "m": 240, "coef": 3, "url": "https://www.cnfpt.fr/evoluer/preparation-aux-concours-concours-examens-professionnels/decouvrir-concours-examens-professionnels/concours-dadministrateur-ou-administratrice-territorial/sujets-meilleures-copies-du-concours-dadministrateur-territorial/sujets-session-2024-du", "src": "https://www.cnfpt.fr/evoluer/preparation-aux-concours-concours-examens-professionnels/decouvrir-concours-examens-professionnels/concours-dadministrateur-ou-administratrice-territorial/sujets-meilleures-copies-du-concours-dadministrateur-territorial/sujets-session-2024-du", "review": "https://www.cnfpt.fr/evoluer/quels-sont-concours-examens-professionnels-organises-cnfpt/devenir-administrateur-ou-administratrice-territorial-concours/national", "info": "Choisir le document correspondant à cette épreuve sur la page officielle."}, {"id": "p2024droit", "l": "P", "y": 2024, "t": "Droit public", "m": 240, "coef": 3, "url": "https://www.cnfpt.fr/evoluer/preparation-aux-concours-concours-examens-professionnels/decouvrir-concours-examens-professionnels/concours-dadministrateur-ou-administratrice-territorial/sujets-meilleures-copies-du-concours-dadministrateur-territorial/sujets-session-2024-du", "src": "https://www.cnfpt.fr/evoluer/preparation-aux-concours-concours-examens-professionnels/decouvrir-concours-examens-professionnels/concours-dadministrateur-ou-administratrice-territorial/sujets-meilleures-copies-du-concours-dadministrateur-territorial/sujets-session-2024-du", "review": "https://www.cnfpt.fr/evoluer/quels-sont-concours-examens-professionnels-organises-cnfpt/devenir-administrateur-ou-administratrice-territorial-concours/national", "info": "Choisir le document correspondant à cette épreuve sur la page officielle."}, {"id": "p2024exp", "l": "P", "y": 2024, "t": "Valorisation de l’expérience professionnelle", "m": 240, "coef": 5, "url": "https://www.cnfpt.fr/evoluer/preparation-aux-concours-concours-examens-professionnels/decouvrir-concours-examens-professionnels/concours-dadministrateur-ou-administratrice-territorial/sujets-meilleures-copies-du-concours-dadministrateur-territorial/sujets-session-2024-du", "src": "https://www.cnfpt.fr/evoluer/preparation-aux-concours-concours-examens-professionnels/decouvrir-concours-examens-professionnels/concours-dadministrateur-ou-administratrice-territorial/sujets-meilleures-copies-du-concours-dadministrateur-territorial/sujets-session-2024-du", "review": "https://www.cnfpt.fr/evoluer/quels-sont-concours-examens-professionnels-organises-cnfpt/devenir-administrateur-ou-administratrice-territorial-concours/national", "info": "Choisir le document correspondant à cette épreuve sur la page officielle."}, {"id": "p2024soc", "l": "P", "y": 2024, "t": "Société contemporaine", "m": 300, "coef": 3, "url": "https://www.cnfpt.fr/sites/default/files/document/1737125733/sujet-concours-interne-administrateur-territorial-2024-composition-question-contemporaine.pdf", "src": "https://www.cnfpt.fr/evoluer/preparation-aux-concours-concours-examens-professionnels/decouvrir-concours-examens-professionnels/concours-dadministrateur-ou-administratrice-territorial/sujets-meilleures-copies-du-concours-dadministrateur-territorial/sujets-session-2024-du", "review": "https://www.cnfpt.fr/evoluer/quels-sont-concours-examens-professionnels-organises-cnfpt/devenir-administrateur-ou-administratrice-territorial-concours/national", "info": "Lutte contre les incivilités"}, {"id": "p2024fin", "l": "P", "y": 2024, "t": "Finances publiques", "m": 180, "coef": 2, "url": "https://www.cnfpt.fr/evoluer/preparation-aux-concours-concours-examens-professionnels/decouvrir-concours-examens-professionnels/concours-dadministrateur-ou-administratrice-territorial/sujets-meilleures-copies-du-concours-dadministrateur-territorial/sujets-session-2024-du", "src": "https://www.cnfpt.fr/evoluer/preparation-aux-concours-concours-examens-professionnels/decouvrir-concours-examens-professionnels/concours-dadministrateur-ou-administratrice-territorial/sujets-meilleures-copies-du-concours-dadministrateur-territorial/sujets-session-2024-du", "review": "https://www.cnfpt.fr/evoluer/quels-sont-concours-examens-professionnels-organises-cnfpt/devenir-administrateur-ou-administratrice-territorial-concours/national", "info": "Choisir le document correspondant à cette épreuve sur la page officielle."}];

let officialId='';let officialObjectURL='';
function officialState(id){state.official=state.official||{};return state.official[id]||(state.official[id]={draft:'',copy:'',end:0,finished:false,score:null});}
function officialView(){const list=officialExams.filter(x=>x.l===level);if(!list.some(x=>x.id===officialId))officialId=list[0].id;const x=list.find(x=>x.id===officialId),v=officialState(x.id);return `<section><h3>Annales officielles — simulation en conditions réelles</h3><p>Les sujets proviennent des organisateurs. Les dossiers restent sur leurs sites ; ouvre ou télécharge le sujet avant de démarrer. Les anciennes règles et données sont celles de la session.</p><label>Épreuve <select id="officialSelect">${list.map(z=>`<option value="${z.id}" ${z.id===x.id?'selected':''}>${z.y} — ${esc(z.t)}</option>`).join('')}</select></label><p><b>${x.m/60} heures · coefficient ${x.coef}</b> — ${esc(x.info)}</p><p><a href="${x.url}" target="_blank" rel="noopener">Ouvrir le sujet officiel ↗</a> · <a href="${x.src}" target="_blank" rel="noopener">Catalogue de la session</a></p><label>Importer le PDF téléchargé pour lire et rédiger côte à côte (facultatif)<input type="file" id="officialPdf" accept="application/pdf"></label><button id="officialStart" class="primary" ${v.end||v.finished?'disabled':''}>Démarrer l’épreuve</button> <button id="officialFinish" ${!v.end||v.finished?'disabled':''}>Rendre la copie</button> <button id="officialReset">Nouvelle tentative</button><p><output id="officialClock">${x.m}:00</output> <span id="officialStatus"></span></p><progress id="officialProgress" max="${x.m*60}" value="0" style="width:100%"></progress></section><div class="examworkspace"><article id="officialViewer" hidden></article><article><h3>Brouillon</h3><textarea id="officialDraft" rows="8" ${!v.end||v.finished?'disabled':''}>${esc(v.draft)}</textarea><h3>Copie définitive</h3><textarea id="officialCopy" rows="20" ${!v.end||v.finished?'disabled':''}>${esc(v.copy)}</textarea><p id="officialWords"></p><button id="officialExport">Exporter la copie (.txt)</button></article></div><section id="officialReview" ${v.finished?'':'hidden'}><h3>Après remise — analyse de la copie</h3><p><a href="${x.review}" target="_blank" rel="noopener">Rapports de jury / bonnes copies lorsqu’ils sont disponibles</a>. Une bonne copie n’est pas un corrigé officiel.</p><p>Évalue chaque critère sur 4 : respect de la commande ; exactitude et exploitation des sources ; argumentation ; pertinence des propositions ou de la réflexion ; structure et expression.</p>${['Commande','Connaissances','Argumentation','Pertinence','Expression'].map((k,i)=>`<label>${k} <input class="officialMark" type="number" min="0" max="4" step="0.5" value="${v.marks?.[i]??''}"></label>`).join('')}<button id="officialGrade">Enregistrer mon auto-évaluation</button> <output id="officialScore">${v.score===null?'':v.score+'/20'}</output><p>Note indicative, non calculée par une IA ni attribuée par un jury.</p></section><section><h3>Historique des annales</h3>${list.filter(z=>officialState(z.id).finished).map(z=>`<p>${z.y} — ${esc(z.t)} : ${officialState(z.id).score??'non noté'}/20</p>`).join('')||'<p>Aucune copie remise.</p>'}</section>`}
function bindOfficial(){const x=officialExams.find(z=>z.id===officialId),v=officialState(x.id);$('officialSelect').onchange=e=>{officialId=e.target.value;go('Annales réelles')};$('officialPdf').onchange=e=>{const f=e.target.files[0];if(!f)return;if(officialObjectURL)URL.revokeObjectURL(officialObjectURL);officialObjectURL=URL.createObjectURL(f);const box=$('officialViewer');box.hidden=false;box.innerHTML='<h3>Dossier importé</h3><iframe title="Dossier officiel importé" style="width:100%;height:680px;border:1px solid #ccd8e2" src="'+officialObjectURL+'"></iframe>'};const words=()=>{$('officialWords').textContent=(v.copy.trim()?v.copy.trim().split(/\s+/).length:0)+' mots dans la copie'};for(const [id,key] of [['officialDraft','draft'],['officialCopy','copy']])$(id).oninput=e=>{v[key]=e.target.value;save();words()};words();function finish(){v.finished=true;save();$('officialDraft').disabled=true;$('officialCopy').disabled=true;$('officialFinish').disabled=true;$('officialReview').hidden=false;$('officialStatus').textContent='Copie remise';clearInterval(timer)}function tick(){let n=v.end?Math.max(0,Math.ceil((v.end-Date.now())/1000)):x.m*60;$('officialClock').textContent=Math.floor(n/60)+':'+String(n%60).padStart(2,'0');$('officialProgress').value=x.m*60-n;if(v.finished){$('officialStatus').textContent='Copie remise';return}if(v.end&&n===0)finish();else $('officialStatus').textContent=v.end?'Épreuve en cours — sans pause':'Prêt à démarrer'}$('officialStart').onclick=()=>{v.end=Date.now()+x.m*60000;save();$('officialStart').disabled=true;$('officialFinish').disabled=false;$('officialDraft').disabled=false;$('officialCopy').disabled=false;tick();clearInterval(timer);timer=setInterval(tick,250)};$('officialFinish').onclick=()=>{if(confirm('Rendre définitivement la copie ?'))finish()};$('officialReset').onclick=()=>{if(confirm('Effacer la tentative actuelle pour cette annale ? Exporte ta copie auparavant.')){delete state.official[x.id];save();go('Annales réelles')}};$('officialExport').onclick=()=>{const u=URL.createObjectURL(new Blob([x.y+' — '+x.t+'\n\n'+v.copy],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=u;a.download=x.id+'-copie.txt';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)};$('officialGrade').onclick=()=>{const inputs=[...document.querySelectorAll('.officialMark')];if(inputs.some(e=>e.value===''||!e.checkValidity())){alert('Renseigne les cinq notes entre 0 et 4.');return}v.marks=inputs.map(e=>+e.value);v.score=v.marks.reduce((a,b)=>a+b,0);save();$('officialScore').textContent=v.score+'/20'};tick();if(v.end&&!v.finished)timer=setInterval(tick,250)}


const learningSteps=[
['Découvrir le sens général','Notices pédagogiques','5 min','Lire la notice de la matière et son objectif. Repérer les mots inconnus.','Je peux expliquer en une phrase le sujet et son utilité pour une collectivité.'],
['Se familiariser avec le contexte','Cours','10 min','Identifier les acteurs, leurs compétences, le contexte juridique et les besoins des usagers.','Je sais qui intervient, pourquoi et dans quel cadre.'],
['Comprendre les mécanismes','Cours','20 min','Lire À comprendre et Approfondissement. Expliquer les causes, les règles et les effets. Vérifier les références utiles.','Je peux expliquer le fonctionnement sans réciter le texte.'],
['Visualiser et relier','Schémas','10 min','Observer le schéma, puis le redessiner sans modèle avec des flèches et des mots-clés.','Je peux reconstruire les étapes et expliquer leurs liens.'],
['Étudier un exemple concret','Cours','10 min','Lire l’exemple, identifier la règle appliquée et imaginer une situation différente.','Je sais transférer la notion à un autre contexte.'],
['Mémoriser activement','Révisions actives','10 min','Fermer le cours, répondre de mémoire puis vérifier. Noter les erreurs plutôt que relire passivement.','Je peux donner la définition, les acteurs et un exemple de mémoire.'],
['Vérifier les connaissances','QCM','10 min','Faire les questions pertinentes et expliquer pourquoi chaque réponse est correcte ou incorrecte.','Je justifie mes réponses ; les erreurs sont identifiées.'],
['Appliquer au niveau du concours','Cas pratiques','20 min','Traiter une situation : B, organiser ; A, analyser et piloter ; A+, comparer les scénarios et conseiller un arbitrage.','Ma réponse tient compte des contraintes et de la commande.'],
['Développer un argument','Coach rédaction','15 min','Rédiger un paragraphe : affirmation, justification, preuve, conséquence, action et évaluation si pertinente.','Mon argument est expliqué et illustré, pas seulement énoncé.'],
['Corriger et reformuler','Laboratoire','10 min','Comparer avec les corrigés indicatifs, relever deux lacunes puis réécrire le passage sans recopier.','Je sais expliquer mes erreurs et produire une meilleure réponse.'],
['S’entraîner en conditions réelles','Annales réelles','Selon épreuve','Choisir un sujet officiel, analyser la commande et le dossier, préparer le plan puis rédiger en temps limité. À faire après plusieurs cours.','Je respecte la commande, la durée et la structure attendue.'],
['Consolider dans le temps','Planning méthode J','10–20 min par rappel','Programmer les rappels J1, J3, J7, J14, J30 et J60. Reprendre les notions non acquises.','Je restitue et applique la notion après un délai, sans aide.']];
function stepKey(){return level+'-'+(state.stepCourse||0)}
function stepToggle(i,v){state.learningChecks=state.learningChecks||{};const k=stepKey();state.learningChecks[k]=state.learningChecks[k]||{};state.learningChecks[k][i]=v;save();render()}
function stepSelect(v){state.stepCourse=Number(v);save();render()}
function stepOpen(t){go(t);if(t==='Cours'||t==='Schémas'){const cards=[...$('main').querySelectorAll('article')];const card=cards[state.stepCourse||0];if(card)card.scrollIntoView({block:'start',behavior:'smooth'})}}
function stepView(){let i=Math.min(courses.length-1,Math.max(0,Number(state.stepCourse)||0));let c=courses[i], checks=(state.learningChecks||{})[level+'-'+i]||{};let n=learningSteps.filter((_,j)=>checks[j]).length;return '<section class="stepintro"><h3>Ton itinéraire de formation, étape par étape</h3><p>Commence par comprendre, puis mémorise et applique. Ne valide une étape que si tu réussis son critère sans aide. Les durées sont indicatives : répartis les étapes sur plusieurs séances.</p><label>Choisir le cours <select onchange="stepSelect(this.value)">'+courses.map((x,j)=>'<option value="'+j+'" '+(j===i?'selected':'')+'>'+esc(x[0])+'</option>').join('')+'</select></label><p><b>Objectif : </b>'+esc(c[1])+'</p><progress max="12" value="'+n+'" style="width:100%"></progress><p>'+n+' / 12 étapes validées — '+(level==='P'?'A+':level)+'</p><p><b>Exemple à garder en tête :</b> '+esc(c[4])+'</p><button onclick="window.print()">Imprimer mon parcours</button></section>'+learningSteps.map((x,j)=>'<article class="stepcard '+(checks[j]?'stepdone':'')+'"><div class="stephead"><span class="stepnum">'+(j+1)+'</span><div><h3>'+esc(x[0])+'</h3><small>'+esc(x[2])+' · '+esc(x[1])+'</small></div></div><p><b>Ce que je fais :</b> '+esc(x[3])+'</p><p class="stepcriterion"><b>Je valide si :</b> '+esc(x[4])+'</p><button data-stepmodule="'+esc(x[1])+'" onclick="stepOpen(this.dataset.stepmodule)">Ouvrir '+esc(x[1])+'</button><label><input type="checkbox" '+(checks[j]?'checked':'')+' onchange="stepToggle('+j+',this.checked)"> Étape acquise</label></article>').join('')+'<section><h3>Exemple de répartition</h3><p>Séance 1 : étapes 1 à 4. Séance 2 : étapes 5 à 7. Séance 3 : étapes 8 à 10. Après plusieurs cours : étape 11. Tout au long du parcours : étape 12 selon le calendrier J.</p><p>Les validations sont personnelles, enregistrées dans ce navigateur séparément pour chaque concours et cours ; elles ne constituent pas une certification.</p></section>'}

function render(){$('nav').innerHTML=tabs.map(t=>'<button class="'+(t===tab?'active':'')+'">'+t+'</button>').join('');[...$('nav').children].forEach((b,i)=>b.onclick=()=>go(tabs[i]));let h='<h2>'+tab+'</h2>';if(tab==='Maîtrise progressive')h+=masterView();if(tab==='Glossaire')h+=glossaryView();if(tab==='Carnet d’erreurs')h+=errorView();if(tab==='Réponses commentées')h+=copyView();if(tab==='Planning méthode J')h+=jView();if(tab==='Étapes d’apprentissage')h+=stepView();if(['Parcours guidé','Diagnostic','Révisions actives','Coach rédaction'].includes(tab))h+=pedView();if(tab==='Accueil')h+='<div class="grid"><article>Fiches révisées<br><output>'+Object.values(state.done).filter(Boolean).length+'/10</output></article><article>QCM réalisés<br><output>'+state.results.length+'</output></article><article>Dernier score<br><output>'+(state.results.at(-1)||'—')+'</output></article></div><section><h3>Programme sur 8 semaines</h3><p>S1–2 : droit, institutions et méthode. S3–4 : économie et finances. S5–6 : gestion et société. S7–8 : concours blancs et oral. Chaque semaine : fiches, QCM, deux paragraphes argumentés et un exercice chronométré.</p><button onclick="go(\'Atelier rédaction\')">Commencer la rédaction</button></section>';
if(tab==='Annales réelles')h+=officialView();if(tab==='Laboratoire')h+=labView();if(tab==='Concours blancs')h+=mockView();if(tab==='Progression')h+=progressView();if(tab==='Cours')h+=courseView();if(tab==='Schémas')h+=schemaView();if(tab==='Méthodes')h+=methodView();
if(tab==='Épreuves')h+='<section><h3>Admissibilité</h3>'+table(exams[level],'h')+'<h3>Admission</h3>'+table(orals[level],'min')+'<p>Repères à vérifier dans le cadrage de la session. A+ : langue facultative non incluse ; note inférieure à 5 éliminatoire aux épreuves obligatoires.</p></section>';
if(tab==='Fiches')h+='<input id="search" placeholder="Rechercher une matière"><div>'+lessons.map((x,i)=>'<article data-search="'+esc(x.join(' '))+'"><h3>'+x[0]+'</h3><p>'+x[1]+'</p><details><summary>Exemple</summary>'+x[2]+'</details><a href="'+x[3]+'" target="_blank" rel="noopener">Source officielle</a><label><input type="checkbox" data-done="'+i+'" '+(state.done[i]?'checked':'')+'> Fiche révisée</label></article>').join('')+'</div>';
if(tab==='QCM')h+='<form id="quiz">'+quiz.map((q,i)=>'<article><h3>'+(i+1)+'. '+q[0]+'</h3>'+q[1].map((a,j)=>'<label><input required type="radio" name="q'+i+'" value="'+j+'"> '+a+'</label>').join('')+'<p id="f'+i+'"></p></article>').join('')+'<button class="primary">Corriger</button> <output id="score"></output></form>';
if(tab==='Cas pratiques')h+='<section><button onclick="start(180)">3 h</button> <button onclick="start(240)">4 h</button> <button onclick="start(300)">5 h</button> <output id="clock">00:00</output></section>'+cases.map((x,i)=>'<article><h3>'+x[0]+'</h3><p><b>Commande :</b> '+x[1]+'</p><p>'+x[2]+'</p>'+draft('case'+i,'Réponse')+'<details><summary>Corrigé indicatif</summary>'+x[3]+'</details></article>').join('');
if(tab==='Atelier rédaction')h+='<section><h3>De l’idée au paragraphe</h3><p>Constat → preuve → enjeu → conséquence → action → moyens → évaluation. Pour une synthèse, respecter les documents et distinguer les propositions personnelles selon le cadrage.</p><details open><summary>Exemple développé</summary>Les usages non encadrés de l’IA peuvent exposer des informations professionnelles. Une formation différenciée par métier, associée à une charte validée et à un accompagnement de proximité, réduit les usages à risque. La DSI et les RH pilotent le dispositif ; un bilan à six mois mesure la couverture de formation et les incidents signalés.</details>'+['Commande et destinataire','Constat et preuve','Enjeux et risques','Argument et exemple','Solutions et arbitrage','Moyens et calendrier','Indicateurs et limites'].map((x,i)=>draft('write'+i,x)).join('')+'<p id="words"></p><button onclick="window.print()">Imprimer</button></section>';
if(tab==='Oral')h+='<section><p>Répondre en deux minutes : situation, action, résultat, recul critique.</p><button onclick="start(2)">2 min</button> <button onclick="start(10)">10 min</button> <output id="clock">00:00</output>'+['Présentez votre parcours et votre motivation.','Comment arbitrez-vous un conflit entre services ?','Comment conseillez-vous un élu face à un risque juridique ?','Comment associez-vous les agents à une réorganisation ?','Comment évaluez-vous une politique publique ?'].map((x,i)=>draft('oral'+i,x)).join('')+'<p>Exercice collectif : écouter, reformuler, structurer, faciliter l’arbitrage et rendre compte. À pratiquer aussi en groupe réel.</p></section>';
if(tab==='Simulateurs')h+='<section><h3>Notes écrites pondérées</h3>'+exams[level].map(x=>'<label>'+x[0]+' (coef. '+x[2]+') <input class="note" type="number" min="0" max="20" step="0.5" value="10" data-c="'+x[2]+'"></label>').join('')+'<output id="avg"></output><p>Le seuil réel dépend du jury. Langue facultative A/A+ non incluse dans la simulation.</p><h3>Finances publiques</h3><label>Recettes (€) <input id="r" type="number" value="12000000"></label><label>Dépenses (€) <input id="d" type="number" value="10000000"></label><label>Capital remboursé (€) <input id="k" type="number" value="800000"></label><output id="fin"></output></section>';
if(tab==='Sources')h+='<section><p>Cadre B : décret 2012-942, art. 6 ; A : décret 2009-756, art. 7 et 10 ; A+ : document CNFPT fourni (janvier 2016), à vérifier pour la session. Les contenus pédagogiques sont statiques ; la veille automatisée reste dans le référentiel principal.</p>'+[['CNFPT : cadrage A+','https://www.cnfpt.fr/se-former-au-long-sa-carriere/preparation-aux-concours-a/cadrage-concours-administrateur-territorial/national'],['CNFPT : annales et copies','https://www.cnfpt.fr/evoluer/concours-examens-professionnels/concours-dadministrateur-territorial/national'],['Concours territorial B et A','https://www.concours-territorial.fr/'],['Cour des comptes','https://www.ccomptes.fr/'],['Conseil d’État','https://www.conseil-etat.fr/'],['OFGL','https://www.ofgl.fr/'],...lessons.map(x=>[x[0],x[3]])].map(x=>'<p><a href="'+x[1]+'" target="_blank" rel="noopener">'+x[0]+'</a></p>').join('')+'</section>';
if(tab==='Notices pédagogiques')h+="<section class=\"notice\"><h3>Mode d’emploi — apprendre, comprendre, appliquer</h3><p>Cette notice est un guide pédagogique, non un cadrage officiel du jury. Pour chaque notion : définir, expliquer son mécanisme, illustrer, identifier les risques, proposer et évaluer. Ne pas apprendre les textes par cœur sans comprendre leur portée.</p><div class=\"grid\"><article><h3>B — Organiser</h3>Appliquer les règles, traiter les dossiers, organiser le service.</article><article><h3>A — Piloter</h3>Analyser, construire un projet, mobiliser les acteurs et évaluer.</article><article><h3>A+ — Arbitrer</h3>Comparer les scénarios, conseiller les élus, apprécier les coûts et les impacts.</article></div><p><button onclick=\"window.print()\">Imprimer la notice</button> <button onclick=\"go('Cours')\">Accéder aux cours</button> <button onclick=\"go('Laboratoire')\">S’entraîner à rédiger</button></p></section>\n<section><h3>1. Les connaissances à maîtriser</h3><p>Ouvre chaque notice. Après lecture, explique la notion sans support et réalise l’exercice proposé avant de cocher la compétence.</p><details><summary>01 — Institutions territoriales</summary><p><b>À apprendre :</b> Décentralisation, déconcentration, compétences, EPCI, libre administration.</p><p><b>À comprendre :</b> Distinguer décideur, financeur, exécutant et contrôleur. Les collectivités ne sont pas hiérarchisées entre elles.</p><p><b>Exemple / exercice :</b> Une commune veut agir sur une compétence transférée : vérifier le périmètre du transfert avant de proposer une action.</p><label><input type=\"checkbox\" data-notice=\"0\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>02 — Droit administratif</summary><p><b>À apprendre :</b> Hiérarchie des normes, actes, légalité, recours, contrôle de légalité.</p><p><b>À comprendre :</b> Vérifier compétence, procédure, fondement et proportionnalité.</p><p><b>Exemple / exercice :</b> Une décision restrictive est envisagée : identifier les garanties et les voies de recours.</p><label><input type=\"checkbox\" data-notice=\"1\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>03 — Finances publiques</summary><p><b>À apprendre :</b> Budget primitif, fonctionnement, investissement, épargne, dette, PPI.</p><p><b>À comprendre :</b> Épargne brute = recettes réelles de fonctionnement − dépenses réelles de fonctionnement ; épargne nette = épargne brute − capital remboursé.</p><p><b>Exemple / exercice :</b> 15 M€ − 12 M€ = 3 M€ ; avec 1 M€ de capital remboursé, épargne nette = 2 M€. Expliquer la marge de financement.</p><label><input type=\"checkbox\" data-notice=\"2\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>04 — Économie</summary><p><b>À apprendre :</b> PIB, croissance réelle, inflation, chômage, pouvoir d’achat, taux, déficit et dette.</p><p><b>À comprendre :</b> Relier les évolutions économiques à leurs effets sur les ménages et les collectivités.</p><p><b>Exemple / exercice :</b> Inflation → achats plus coûteux → dépenses accrues → épargne réduite à recettes constantes → arbitrages.</p><label><input type=\"checkbox\" data-notice=\"3\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>05 — Commande publique</summary><p><b>À apprendre :</b> Définition du besoin, liberté d’accès, égalité et transparence.</p><p><b>À comprendre :</b> Choisir la procédure applicable et maîtriser coût global et risques.</p><p><b>Exemple / exercice :</b> Comparer deux offres en utilisant les critères annoncés et non une préférence personnelle.</p><label><input type=\"checkbox\" data-notice=\"4\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>06 — RH et GPEC</summary><p><b>À apprendre :</b> Statut, recrutement, formation, mobilité, emplois et compétences.</p><p><b>À comprendre :</b> Comparer les besoins futurs et les compétences disponibles.</p><p><b>Exemple / exercice :</b> Construire un plan de formation face à la dématérialisation des démarches.</p><label><input type=\"checkbox\" data-notice=\"5\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>07 — Management</summary><p><b>À apprendre :</b> Délégation, motivation, conflits, changement.</p><p><b>À comprendre :</b> Distinguer symptômes et causes ; accompagner les équipes.</p><p><b>Exemple / exercice :</b> Face à l’absentéisme, analyser les causes avant de réorganiser.</p><label><input type=\"checkbox\" data-notice=\"6\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>08 — IA et numérique</summary><p><b>À apprendre :</b> RGPD, confidentialité, sécurité, responsabilité, gouvernance.</p><p><b>À comprendre :</b> Identifier les usages, données et risques avant le déploiement.</p><p><b>Exemple / exercice :</b> Proposer une charte, un pilote et une formation avec DSI et DPO.</p><label><input type=\"checkbox\" data-notice=\"7\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>09 — Questions sociales</summary><p><b>À apprendre :</b> Protection sociale, handicap, précarité, vieillissement, non-recours.</p><p><b>À comprendre :</b> Identifier les acteurs et les obstacles à l’accès aux droits.</p><p><b>Exemple / exercice :</b> Concevoir un accueil multicanal accessible.</p><label><input type=\"checkbox\" data-notice=\"8\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>10 — Évaluation des politiques publiques</summary><p><b>À apprendre :</b> Objectifs, efficacité, efficience, impact.</p><p><b>À comprendre :</b> Distinguer activité, résultat et impact ; choisir un indicateur fiable.</p><p><b>Exemple / exercice :</b> Mesurer les délais et la satisfaction avant et après une réforme.</p><label><input type=\"checkbox\" data-notice=\"9\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>11 — Union européenne</summary><p><b>À apprendre :</b> Institutions, compétences, règlements, directives, financements.</p><p><b>À comprendre :</b> Comprendre l’incidence des normes européennes sur les collectivités.</p><p><b>Exemple / exercice :</b> Identifier les contraintes européennes d’un projet de financement.</p><label><input type=\"checkbox\" data-notice=\"10\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>12 — Société contemporaine</summary><p><b>À apprendre :</b> Démocratie, inégalités, travail, numérique, mutations sociales.</p><p><b>À comprendre :</b> Construire une réflexion avec arguments, objections et exemples.</p><p><b>Exemple / exercice :</b> Le numérique constitue-t-il un progrès pour tous ? Définir progrès et égalité.</p><label><input type=\"checkbox\" data-notice=\"11\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>13 — Responsabilité administrative</summary><p><b>À apprendre :</b> Faute, préjudice, causalité, régimes sans faute.</p><p><b>À comprendre :</b> Distinguer les conditions d’engagement de la responsabilité.</p><p><b>Exemple / exercice :</b> Examiner un dommage causé par un équipement public.</p><label><input type=\"checkbox\" data-notice=\"12\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>14 — Déontologie</summary><p><b>À apprendre :</b> Neutralité, impartialité, probité, laïcité, conflits d’intérêts.</p><p><b>À comprendre :</b> Identifier un risque et choisir une mesure de prévention.</p><p><b>Exemple / exercice :</b> Un agent participe à une décision concernant un proche : examiner le déport.</p><label><input type=\"checkbox\" data-notice=\"13\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>15 — Fiscalité et dette</summary><p><b>À apprendre :</b> Ressources fiscales, emprunts, encours et soutenabilité.</p><p><b>À comprendre :</b> Capacité de désendettement = encours / épargne brute positive ; interpréter avec prudence.</p><p><b>Exemple / exercice :</b> 16 M€ de dette et 2 M€ d’épargne brute : 8 ans théoriques.</p><label><input type=\"checkbox\" data-notice=\"14\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>16 — Analyse des données</summary><p><b>À apprendre :</b> Ratios, pourcentages, évolution et graphiques.</p><p><b>À comprendre :</b> Vérifier période, dénominateur, source et limites.</p><p><b>Exemple / exercice :</b> De 100 à 120 dossiers : +20 %, pas +20 points de pourcentage.</p><label><input type=\"checkbox\" data-notice=\"15\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>17 — Dialogue social</summary><p><b>À apprendre :</b> Instances, consultation, concertation, négociation.</p><p><b>À comprendre :</b> Identifier les obligations de consultation selon la décision envisagée.</p><p><b>Exemple / exercice :</b> Préparer une réorganisation en associant les représentants du personnel.</p><label><input type=\"checkbox\" data-notice=\"16\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>18 — Pilotage de projet</summary><p><b>À apprendre :</b> Objectifs, acteurs, moyens, calendrier, risques.</p><p><b>À comprendre :</b> Définir les responsabilités et les jalons.</p><p><b>Exemple / exercice :</b> Construire un calendrier de déploiement d’un portail usagers.</p><label><input type=\"checkbox\" data-notice=\"17\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>19 — Gestion de crise</summary><p><b>À apprendre :</b> Anticipation, continuité, coordination, communication.</p><p><b>À comprendre :</b> Prioriser les missions essentielles et organiser les responsabilités.</p><p><b>Exemple / exercice :</b> Préparer un plan de continuité en cas de panne informatique.</p><label><input type=\"checkbox\" data-notice=\"18\"> Je sais expliquer et appliquer cette notion sans support</label></details><details><summary>20 — Transition écologique</summary><p><b>À apprendre :</b> Adaptation, sobriété, énergie, politiques environnementales.</p><p><b>À comprendre :</b> Comparer les bénéfices, coûts et effets sociaux à long terme.</p><p><b>Exemple / exercice :</b> Prioriser les rénovations énergétiques selon consommation et coût global.</p><label><input type=\"checkbox\" data-notice=\"19\"> Je sais expliquer et appliquer cette notion sans support</label></details></section><section><h3>2. Décrypter la commande</h3><table><thead><tr><th>Verbe</th><th>Attendu</th></tr></thead><tbody><tr><td>Définir</td><td>Donner le sens précis</td></tr><tr><td>Identifier</td><td>Repérer les éléments utiles</td></tr><tr><td>Présenter</td><td>Exposer de façon structurée</td></tr><tr><td>Expliquer</td><td>Démontrer causes et mécanismes</td></tr><tr><td>Analyser</td><td>Relier les éléments et leurs effets</td></tr><tr><td>Commenter</td><td>Interpréter la portée</td></tr><tr><td>Comparer</td><td>Distinguer avantages et limites</td></tr><tr><td>Évaluer</td><td>Apprécier résultats et écarts</td></tr><tr><td>Préconiser</td><td>Recommander des mesures justifiées</td></tr><tr><td>Arbitrer</td><td>Comparer et justifier un choix</td></tr><tr><td>Synthétiser</td><td>Restituer l’essentiel du dossier</td></tr><tr><td>Problématiser</td><td>Formuler la question centrale</td></tr></tbody></table><h3>3. Lecture du dossier</h3><div class=\"grid\"><article><b>Skimming</b><p>Survoler titres, introductions, conclusions et structure.</p></article><article><b>Scanning</b><p>Cibler chiffres, dates, textes, risques et solutions.</p></article></div><p>Code couleur au brouillon : <mark style=\"background:#f3dc65\">constats</mark> <mark style=\"background:#8fc1ee\">droit</mark> <mark style=\"background:#eda19a\">risques</mark> <mark style=\"background:#a0d4ac\">solutions</mark> <mark style=\"background:#c7b0e4\">moyens et indicateurs</mark>.</p><p>Construire un tableau de repérage : numéro du document, idée utile, partie du plan. Respecter le cadrage concernant les références aux documents.</p></section><section><h3>4. Développer un argument</h3><div class=\"noticeflow\"><div>QUOI ? — Idée</div><div>POURQUOI ? — Justification</div><div>PREUVE ? — Texte, donnée ou exemple</div><div>CONSÉQUENCE ? — Enjeux et risques</div><div>COMMENT ? — Actions</div><div>MOYENS ? — Acteurs, ressources, délais</div><div>RÉSULTATS ? — Indicateurs</div></div><p><b>Idée courte :</b> Il faut former les agents à l’IA.</p><p><b>Argument développé :</b> La formation des agents constitue un levier de sécurisation des usages de l’intelligence artificielle. En effet, une maîtrise insuffisante peut entraîner des erreurs d’interprétation ou la divulgation de données confidentielles. Il convient donc de proposer un parcours différencié selon les métiers, piloté par la DRH et la DSI avec l’appui du DPO. Le taux de participation, les acquis et les incidents signalés permettront d’en apprécier les effets.</p><p>Exercice : développe « Il faut améliorer l’accueil des usagers » en suivant le schéma.</p><textarea data-key=\"notice-argument\" placeholder=\"Ton paragraphe\"></textarea><details><summary>Exemple de réponse</summary>Un accueil accessible favorise l’accès aux droits et limite les dossiers incomplets. La collectivité peut organiser un accompagnement adapté aux publics, en conservant plusieurs canaux d’accès. Le responsable du service suivra les délais, le taux de dossiers incomplets et la satisfaction des usagers.</details></section><section><h3>5. Notices par épreuve</h3><details><summary>Note de synthèse et propositions</summary><p>Commande et destinataire → lecture du dossier → classement thématique → problématique → plan → analyse → propositions selon la commande → relecture. Ne pas juxtaposer les résumés des documents ; ne pas inventer des éléments dans la synthèse.</p></details><details><summary>Cas professionnel</summary><p>Diagnostic → causes → risques → scénarios → recommandation → moyens et calendrier → évaluation. Adopter le rôle demandé et distinguer la proposition technique de la décision de l’autorité compétente.</p></details><details><summary>Composition de société contemporaine</summary><p>Définir les termes → identifier une tension → problématiser → argumenter avec exemples et objections → conclure de manière nuancée. Ne pas transformer systématiquement la composition en plan d’action.</p></details><details><summary>Finances publiques</summary><p>Définition → formule → calcul avec unité → interprétation → limites. Pour une question non chiffrée : réponse directe, mécanisme et exemple.</p></details><details><summary>Entretien avec le jury</summary><p>Méthode STAR : Situation → Tâche → Action personnelle → Résultat et recul. Préparer des exemples vérifiables sans inventer de résultats.</p></details><details><summary>Mise en situation collective</summary><p>Écouter → reformuler → structurer → comparer → faciliter l’arbitrage → restituer. S’entraîner en groupe réel ; ne pas monopoliser la parole.</p></details></section><section><h3>6. Utiliser les modules dans le bon ordre</h3><p>Cours → schémas → fiches → QCM → méthodes → cas pratiques → atelier rédaction → laboratoire → mini-sujets chronométrés → oral → progression. Vérifier les notions auprès des sources officielles. Une erreur de QCM doit conduire à une révision ciblée.</p><h3>7. Programme de 12 semaines</h3><table><tr><th>Semaine</th><th>Objectif et application</th></tr><tr><td>1</td><td>Institutions — carte des compétences</td></tr><tr><td>2</td><td>Droit — analyse de légalité</td></tr><tr><td>3</td><td>Méthode — décryptage de commandes</td></tr><tr><td>4</td><td>Rédaction — paragraphes argumentés</td></tr><tr><td>5</td><td>Finances — calculs et interprétation</td></tr><tr><td>6</td><td>Économie — chaînes de causalité</td></tr><tr><td>7</td><td>RH — cas GPEC</td></tr><tr><td>8</td><td>Management — scénarios</td></tr><tr><td>9</td><td>Social — accès aux droits</td></tr><tr><td>10</td><td>Société — composition</td></tr><tr><td>11</td><td>Stratégie — cas professionnel A+</td></tr><tr><td>12</td><td>Entraînement général — écrit et oral</td></tr></table><p>Répartition conseillée, non officielle : rédaction 30 %, finances 20 %, économie 15 %, droit et institutions 15 %, management 10 %, culture générale et oral 10 %.</p></section><section><h3>8. Bilan personnel des acquis</h3><output id=\"noticeProgress\"></output><progress id=\"noticeBar\" max=\"20\" value=\"0\" style=\"width:100%\"></progress><p>Les cases des 20 notices sont conservées dans le navigateur. La progression est une auto-évaluation, non une note de concours.</p><button onclick=\"go('Progression')\">Sauvegarder ma progression</button></section>";$('main').innerHTML=h;if(tab==='Annales réelles')bindOfficial();if(tab==='Notices pédagogiques')bindNotices();if(tab==='Diagnostic')pedDiagTotal();document.querySelectorAll('[data-key]').forEach(e=>e.oninput=()=>{state.drafts[e.dataset.key]=e.value;save();words()});document.querySelectorAll('[data-done]').forEach(e=>e.onchange=()=>{state.done[e.dataset.done]=e.checked;save()});if($('search'))$('search').oninput=e=>document.querySelectorAll('[data-search]').forEach(c=>c.hidden=!c.dataset.search.toLowerCase().includes(e.target.value.toLowerCase()));if($('quiz'))$('quiz').onsubmit=e=>{e.preventDefault();let n=0,f=new FormData(e.target);quiz.forEach((q,i)=>{let ok=+f.get('q'+i)===q[2];n+=ok;$('f'+i).textContent=(ok?'Correct. ':'Réponse : '+q[1][q[2]]+'. ')+q[3]});$('score').textContent=n+'/'+quiz.length;state.results.push(n+'/'+quiz.length);save()};if($('avg')){const calc=()=>{let a=[...document.querySelectorAll('.note')];$('avg').textContent=a.some(x=>x.value===''||+x.value<0||+x.value>20)?'Notes invalides':(a.reduce((s,x)=>s+ +x.value*+x.dataset.c,0)/a.reduce((s,x)=>s+ +x.dataset.c,0)).toFixed(2)+'/20'+(a.some(x=>+x.value<5)?' — vérifier le seuil éliminatoire':'')};document.querySelectorAll('.note').forEach(x=>x.oninput=calc);calc();const fin=()=>{let b=+$('r').value-+$('d').value;$('fin').textContent='Brute : '+b.toLocaleString('fr-FR')+' € ; nette : '+(b-+$('k').value).toLocaleString('fr-FR')+' €'};['r','d','k'].forEach(x=>$(x).oninput=fin);fin()}words();bindV3()}
function words(){if($('words'))$('words').textContent='Mots rédigés : '+[...document.querySelectorAll('textarea')].reduce((s,x)=>s+(x.value.trim()?x.value.trim().split(/\s+/).length:0),0)}function start(m){clearInterval(timer);let end=Date.now()+m*60000;function tick(){let n=Math.max(0,Math.ceil((end-Date.now())/1000));if(!$('clock')){clearInterval(timer);return}$('clock').textContent=Math.floor(n/60)+':'+String(n%60).padStart(2,'0');if(!n)clearInterval(timer)}tick();timer=setInterval(tick,250)}
const lab=[['Repérer la commande','Le DGS demande une note sur la réorganisation de l’accueil, avec des propositions chiffrées.','Destinataire : DGS ; objet : organisation ; livrable : note et propositions ; contraintes : chiffrage.'],['Transformer une idée en argument','Il faut former les agents.','La formation réduit le risque d’erreur lorsque les règles sont nouvelles. Un parcours par métier, comprenant des exercices sur dossiers fictifs, sécurise la pratique. Le responsable RH suit le taux de participation et les erreurs avant/après.'],['Construire une problématique','La dématérialisation des services publics.','Comment améliorer la qualité et l’efficience des services numériques sans aggraver les inégalités d’accès ?'],['Formuler un arbitrage','Deux solutions : guichet unique à 80 000 € ou mutualisation à 45 000 €.','Comparer coût complet, accessibilité, délais, risques et ressources ; recommander une option conditionnée à un pilote et à des critères mesurables.'],['Rédiger une transition','I. Les risques de l’IA ; II. Les leviers.','Ces risques ne justifient pas un rejet systématique de l’outil : ils imposent une gouvernance proportionnée permettant de concilier innovation et sécurité.'],['Rédiger un indicateur','Améliorer le service.','Réduire le délai médian de traitement de 15 à 10 jours en six mois, sur les dossiers complets, avec suivi mensuel et contrôle de la qualité.']];
function labView(){return '<section><h3>Entraînement guidé : une difficulté à la fois</h3>'+flow('Lire → repérer → expliquer → illustrer → proposer → évaluer')+'<p>Rédige avant d’ouvrir le modèle. Compare ensuite ta réponse, sans chercher à reproduire mécaniquement les formulations.</p></section>'+lab.map((x,i)=>'<article><h3>'+x[0]+'</h3><p>'+x[1]+'</p>'+draft('lab'+i,'Ta rédaction')+'<details><summary>Modèle et correction</summary><p>'+x[2]+'</p></details></article>').join('')}
const mocks=[['B','Rapport avec propositions',180,'Une commune reçoit 800 demandes par mois ; 25 % sont incomplètes. Délai médian : 15 jours. Deux agents accueillent le public. Le responsable demande un rapport pour réduire les délais sans exclure les personnes éloignées du numérique.','Présenter les difficultés et leurs effets ; proposer une procédure de contrôle, une aide à la constitution du dossier, un suivi mensuel et un test de trois mois.'],['B','Questions professionnelles',180,'1. Distinguer décentralisation et déconcentration. 2. Expliquer le rôle du conseil municipal. 3. Définir l’épargne brute. 4. Décrire une démarche de prévention de l’absentéisme.','1. Compétences propres des collectivités vs organisation territoriale de l’État. 2. Délibérations et budget. 3. RRF − DRF. 4. Diagnostic, prévention, acteurs, actions, indicateurs.'],['A','Rapport opérationnel',240,'Une ville de 35 000 habitants souhaite mutualiser trois accueils. Les délais sont de 15 jours ; deux logiciels incompatibles ; budget d’investissement 70 000 €. Les agents craignent une perte d’autonomie. Le DGS attend des propositions.','I. Diagnostic, qualité de service, risques techniques et sociaux. II. Comparer mutualisation physique et coordination hybride ; pilote, gouvernance, formation, financement et évaluation.'],['P','Économie',240,'Inflation des achats : +8 %, recettes nominales : +2 %, demande sociale en hausse. Une collectivité souhaite maintenir les services et investir. Analysez les mécanismes et proposez une stratégie.','Distinguer choc nominal et réel, effets sur ménages et budget ; scénarios d’achat, programmation, ciblage social, suivi des coûts et de l’accès.'],['P','Droit public',240,'Une ville envisage un dispositif numérique obligatoire pour les inscriptions et une collecte de justificatifs élargie. Les associations signalent des difficultés d’accès. Proposez un cadre sécurisé.','Examiner compétence, égalité, accessibilité, proportionnalité, protection des données ; prévoir alternative humaine, minimisation, gouvernance et contrôle.'],['P','Cas professionnel',240,'La direction doit réduire les dépenses de 500 000 € sans détériorer la continuité des services. Trois scénarios : mutualisation, réorganisation, report d’investissements. Préparez un arbitrage.','Comparer les économies réelles, délais, coûts de transition, risques RH et qualité ; distinguer fonctionnement et investissement ; recommandation conditionnelle et calendrier.'],['P','Société contemporaine',300,'Le progrès technique est-il nécessairement un progrès social ?','Problématiser la distinction entre innovation et amélioration collective ; montrer bénéfices et limites ; examiner conditions d’inclusion, gouvernance et maîtrise des effets.'],['P','Finances publiques',180,'RRF 30 M€, DRF 26 M€, capital remboursé 1,5 M€, dette 24 M€. 1. Calculer épargne brute et nette. 2. Capacité de désendettement. 3. Effets d’un choc de dépenses de 1 M€.','Brute 4 M€, nette 2,5 M€, dette/épargne = 6 ans. Après choc : 3 M€, 1,5 M€, 8 ans. Analyser la trajectoire et les marges.']];
function mockView(){return '<section><p>Mini-sujets originaux d’entraînement, non officiels. Durées réglementaires affichées comme repères ; les dossiers sont volontairement courts, pas des annales complètes.</p><output id="clock">00:00</output> <button onclick="clearInterval(timer)">Arrêter</button></section>'+mocks.map((x,i)=>x[0]===level?'<article><h3>'+x[1]+'</h3><p>'+x[3]+'</p><button onclick="start('+x[2]+')">Chronomètre : '+x[2]+' min</button>'+draft('mock'+i,'Copie')+'<details><summary>Axes de correction</summary><p>'+x[4]+'</p></details></article>':'').join('')+'<section><h3>Grille d’auto-évaluation /20</h3><p>Barème pédagogique non officiel, à ajuster selon la commande.</p>'+['Respect de la commande','Connaissances et exploitation du dossier','Analyse et argumentation','Solutions ou réflexion selon l’épreuve','Structure et expression'].map((x,i)=>'<label>'+x+' <input class="rubric" type="number" min="0" max="4" value="0" data-rubric="'+i+'"> /4</label>').join('')+'<output id="rubricScore">0/20</output> <button id="recordScore">Enregistrer mon auto-évaluation</button></section>'}
function progressView(){let a=state.assess||[];return '<section><h3>Journal de progression</h3><p>QCM réalisés : '+state.results.length+' · Auto-évaluations : '+a.length+' · Brouillons : '+Object.values(state.drafts).filter(x=>x.trim()).length+'</p><table><tr><th>Date</th><th>Niveau</th><th>Auto-évaluation</th></tr>'+a.map(x=>'<tr><td>'+esc(x.date)+'</td><td>'+esc(x.level)+'</td><td>'+esc(x.score)+'/20</td></tr>').join('')+'</table><h3>Historique QCM</h3><p>'+esc(state.results.join(' · ')||'Aucun résultat')+'</p></section><section><h3>Sauvegarde et restauration</h3><p>Les travaux restent dans ton navigateur. Télécharge une sauvegarde avant de changer de navigateur ou d’effacer les données.</p><button id="exportState">Exporter ma progression JSON</button><label>Restaurer une sauvegarde <input id="importState" type="file" accept=".json,application/json"></label></section>'}
function bindV3(){if($('rubricScore')){let read=()=>{let a=[...document.querySelectorAll('.rubric')];return a.some(x=>x.value===''||!Number.isFinite(+x.value)||+x.value<0||+x.value>4)?null:a.reduce((s,x)=>s+ +x.value,0)};document.querySelectorAll('.rubric').forEach(x=>x.oninput=()=>{$('rubricScore').textContent=read()===null?'Notes invalides':read()+'/20'});$('recordScore').onclick=()=>{let n=read();if(n===null)return;state.assess||=[];state.assess.push({date:new Date().toLocaleDateString('fr-FR'),level:level==='P'?'A+':level,score:n});save();$('rubricScore').textContent=n+'/20 — enregistré'}}if($('exportState'))$('exportState').onclick=()=>{let u=URL.createObjectURL(new Blob([JSON.stringify({...state,level},null,2)],{type:'application/json'}));let a=document.createElement('a');a.href=u;a.download='terrinormes-progression.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)};if($('importState'))$('importState').onchange=async e=>{try{let f=e.target.files[0];if(!f)return;let v=JSON.parse(await f.text());if(!v||!['B','A','P'].includes(v.level)||!v.done||!v.drafts||!Array.isArray(v.results)||Object.values(v.drafts).some(x=>typeof x!=='string')||v.assess&&!Array.isArray(v.assess))throw Error('Format');if(!confirm('Remplacer les données locales par cette sauvegarde ?'))return;state=v;level=v.level;$('level').value=level;save();render()}catch{alert('Sauvegarde non valide')}}}

function bindNotices(){state.noticeDone=state.noticeDone||{};const update=()=>{let n=Object.values(state.noticeDone).filter(Boolean).length;$('noticeProgress').textContent=n+'/20 compétences — '+n*5+' %';$('noticeBar').value=n};document.querySelectorAll('[data-notice]').forEach(e=>{e.checked=!!state.noticeDone[e.dataset.notice];e.onchange=()=>{state.noticeDone[e.dataset.notice]=e.checked;save();update()}});const draft=document.querySelector('[data-key="notice-argument"]');if(draft)draft.value=state.drafts['notice-argument']||'';update()}
const deepData=[["Compétence et libre administration", "La décentralisation transfère des compétences à des personnes morales distinctes de l’État ; la déconcentration répartit les pouvoirs au sein de l’État. Le préfet ne dirige pas les services municipaux. La commune dispose d’une clause générale de compétence dans les affaires locales, sous réserve des compétences attribuées à d’autres autorités.", "Pour créer un accueil de proximité, identifier le besoin, vérifier les compétences et les transferts à l’EPCI, faire arbitrer les moyens par les autorités compétentes, organiser le service et suivre son accès.", "Confondre contrôle de légalité et autorisation préalable systématique.", "Quelle différence entre décentralisation et déconcentration ?", "La première concerne des collectivités autonomes ; la seconde concerne les services territoriaux de l’État.", "Constitution, art. 72 ; CGCT, art. L2121-29."], ["Légalité externe et interne", "La légalité externe concerne notamment compétence, procédure et forme ; la légalité interne concerne notamment motifs, objet et but. Une mesure de police doit être adaptée, nécessaire et proportionnée.", "Pour limiter les nuisances nocturnes, documenter les faits, comparer des plages horaires et périmètres ciblés, vérifier compétence et motivation puis prévoir un réexamen.", "Croire qu’une décision utile est nécessairement légale.", "Quels sont les deux grands axes du contrôle de légalité d’un acte ?", "Légalité externe et légalité interne.", "CRPA ; Conseil d’État, Benjamin, 19 mai 1933."], ["Équilibres, épargne et arbitrages", "Le fonctionnement finance les charges courantes. L’investissement concerne notamment les équipements. L’emprunt finance l’investissement, non le déficit courant. L’épargne brute constitue une ressource pour rembourser le capital et financer les investissements.", "Avec 15 M€ de recettes et 12 M€ de charges, l’épargne brute vaut 3 M€. Après 1 M€ de capital, l’épargne nette vaut 2 M€. Une dette de 18 M€ correspond à 6 ans de désendettement.", "Confondre encours de dette et annuité ; traiter un ratio comme un seuil universel.", "Que devient l’épargne brute si les charges augmentent de 0,5 M€ à recettes constantes ?", "Elle diminue de 0,5 M€.", "CGCT, art. L1612-4 ; DGCL."], ["Nominal, réel et transmission des chocs", "Une variation nominale ne corrige pas les prix. Une variation réelle se calcule par (1 + variation nominale)/(1 + inflation) − 1. Les chocs touchent différemment ménages, entreprises et budgets publics.", "Recettes +3 %, prix +5 % : pouvoir d’achat budgétaire approximativement −1,9 %. Il faut analyser les postes réellement exposés avant de réduire les prestations.", "Additionner ou soustraire des pourcentages comme s’il s’agissait toujours de montants.", "Pourquoi une hausse nominale peut-elle masquer une baisse réelle ?", "Parce que les prix peuvent augmenter plus vite que le montant nominal.", "INSEE, définitions PIB et inflation."], ["Cycle de l’achat public", "Le besoin doit être défini avant le choix de la procédure. L’estimation porte sur le besoin global selon les règles du code. Les critères annoncés guident l’attribution ; le suivi vérifie la réalisation et les engagements contractuels.", "Pour un outil numérique, comparer coût total, accessibilité, maintenance, sécurité et réversibilité, puis vérifier les livrables pendant l’exécution.", "Choisir un fournisseur avant d’avoir objectivé le besoin et les critères.", "Quels sont les trois principes fondamentaux de la commande publique ?", "Liberté d’accès, égalité de traitement et transparence des procédures.", "Code de la commande publique, art. L3."], ["Des emplois aux compétences", "Un emploi correspond à une fonction ; une compétence est une capacité mobilisable. L’ETP traduit une quotité de travail, distincte du nombre de personnes. La GPEEC rapproche besoins futurs et ressources disponibles.", "Deux agents partent à la retraite : repérer les activités critiques, évaluer les compétences internes, comparer formation, mobilité et recrutement, organiser la transmission.", "Confondre effectif physique et ETP ; recruter sans diagnostic.", "Deux agents à 80 % et 50 % représentent combien d’ETP ?", "1,3 ETP, sous réserve des conventions de calcul.", "CNFPT, ressources GPEEC ; CGFP."], ["Conduire un changement", "Distinguer objectif, moyens et résultats. Le changement implique les métiers, les encadrants et les instances compétentes. Un pilote permet de tester les hypothèses avant généralisation.", "Pour modifier les horaires d’accueil, mesurer les flux, consulter les acteurs, tester deux plages, suivre attentes et qualité, ajuster.", "Prendre la résistance des agents pour une preuve de mauvaise volonté sans examiner les causes.", "Pourquoi associer un indicateur de qualité au délai de traitement ?", "Pour éviter une amélioration apparente des délais au détriment du service rendu.", "CNFPT, management public."], ["Protection des données dès la conception", "Une donnée personnelle concerne une personne identifiable. La pseudonymisation réduit les risques mais ne rend pas nécessairement les données anonymes. Vérifier finalité, base juridique, minimisation, sécurité et durée de conservation.", "Pour un assistant IA, cartographier les données, limiter les usages aux outils autorisés, organiser la supervision humaine et associer DPO et DSI.", "Confondre consentement et base juridique obligatoire pour tout traitement.", "Une donnée pseudonymisée reste-t-elle personnelle si elle est réattribuable ?", "Oui.", "RGPD, art. 4, 5, 6, 25 et 32 ; CNIL."], ["Accès aux droits et non-recours", "Le non-recours peut provenir d’un manque d’information, de difficultés administratives ou d’une absence de demande. La coordination des acteurs doit respecter leurs compétences et la confidentialité.", "Pour un guichet social, suivre demandes commencées, abandonnées et abouties, recueillir les obstacles, conserver une alternative physique.", "Mesurer uniquement les personnes déjà accompagnées.", "Pourquoi les dossiers terminés ne suffisent-ils pas à mesurer l’accès aux droits ?", "Ils excluent notamment les personnes qui abandonnent ou ne demandent pas.", "Vie-publique ; DREES."], ["Objectifs, résultats et impact", "Les moyens sont les ressources, les réalisations les productions, les résultats les changements observés et l’impact l’effet attribuable à la politique. L’efficacité compare objectifs et résultats ; l’efficience rapproche résultats et moyens.", "Un plan de formation : suivre participants, réussite au test, évolution des erreurs et coûts. Comparer avant/après sans attribuer automatiquement toute évolution au plan.", "Assimiler un nombre d’actions à une preuve d’impact.", "Quelle différence entre efficacité et efficience ?", "Atteinte des objectifs contre rapport entre résultats et ressources utilisées.", "Cour des comptes ; France Stratégie."], ["Institutions et normes européennes", "Le Conseil européen fixe les grandes orientations ; le Conseil de l’Union et le Parlement exercent notamment des fonctions législatives. La Commission propose notamment les textes et veille à l’application du droit de l’Union.", "Dans un marché financé par des fonds européens, vérifier les obligations d’éligibilité, de traçabilité et de commande publique applicables.", "Confondre Conseil européen, Conseil de l’Union et Conseil de l’Europe.", "Un règlement européen doit-il être transposé comme une directive ?", "Non : il est directement applicable.", "TFUE, art. 288 ; portail officiel de l’Union européenne."], ["Construire une réflexion critique", "Définir les termes, identifier une tension, mobiliser des exemples précis et examiner les limites. Une composition répond à une question ; elle n’est pas une simple note opérationnelle.", "Le numérique est-il un progrès pour tous ? Opposer les gains d’accès aux risques d’exclusion, puis examiner les conditions d’un progrès inclusif.", "Réciter un plan avantages/inconvénients sans démonstration.", "À quoi sert une problématique ?", "À organiser la démonstration autour d’une question centrale.", "Vie-publique ; annales officielles CNFPT."], ["Responsabilité et réparation", "Identifier le dommage, le fait générateur, le lien causal et le régime applicable. Certains régimes permettent une responsabilité sans faute. Les causes d’exonération et la juridiction compétente dépendent du litige.", "Chute sur un équipement : recueillir faits et photos, vérifier entretien et signalisation, transmettre au juridique et à l’assureur, corriger le danger.", "Conclure automatiquement à la faute de la commune dès qu’un dommage survient.", "Une faute suffit-elle à justifier une indemnisation ?", "Non, notamment sans préjudice réparable ni lien causal.", "Conseil d’État ; jurisprudence administrative."], ["Dialogue social et conduite des projets", "Le comité social territorial intervient dans les domaines prévus par les textes ; la formation spécialisée traite notamment des questions de santé, sécurité et conditions de travail selon son champ. La concertation ne se confond pas avec les consultations obligatoires.", "Avant une réorganisation, identifier les impacts sur les agents, préparer les documents, vérifier les instances à consulter, intégrer les observations et informer les équipes.", "Consulter après une décision irréversible lorsque la consultation préalable est requise.", "Pourquoi distinguer concertation et consultation obligatoire ?", "La seconde relève d’une procédure prévue par les textes.", "CGFP ; décret n° 2021-571 du 10 mai 2021."], ["Préparation et continuité", "Distinguer prévention, préparation, réponse et retour d’expérience. Identifier les activités essentielles, les responsables, les moyens de secours et les canaux d’alerte.", "Panne informatique : activer les procédures dégradées autorisées, prioriser les services essentiels, informer, rétablir et analyser les causes.", "Improviser la répartition des responsabilités pendant la crise.", "Quel est le rôle du retour d’expérience ?", "Identifier les améliorations à apporter au dispositif après l’événement.", "Ministère de l’Intérieur ; ressources de sécurité civile."], ["Atténuation et adaptation", "L’atténuation vise à réduire les émissions de gaz à effet de serre ; l’adaptation réduit la vulnérabilité aux effets du changement climatique. Les politiques locales doivent articuler coût, bénéfices, justice sociale et compétences.", "Rénover une école : comparer isolation, ventilation, protections solaires et végétalisation, en intégrant confort d’été et coût global.", "Confondre réduction des émissions et adaptation à la chaleur.", "Les îlots de fraîcheur relèvent principalement de quel objectif ?", "L’adaptation aux fortes chaleurs.", "ADEME ; ministère de la Transition écologique."], ["Fiscalité, dette et trajectoire", "Les recettes fiscales dépendent de bases, de taux et de règles nationales. L’annuité de dette inclut capital et intérêts ; l’encours mesure le stock restant. La prospective intègre scénarios de recettes, charges, emprunts et investissements.", "Une hausse des taux affecte surtout les nouveaux emprunts et les dettes à taux variable selon leurs conditions. Simuler plusieurs trajectoires avant arbitrage.", "Comparer deux collectivités sans tenir compte de leur périmètre et de leurs ressources.", "Quelle différence entre encours et annuité ?", "Stock de dette restant contre somme des remboursements et intérêts sur une année.", "DGCL ; OFGL."], ["Ratios et qualité des données", "Un pourcentage exige un dénominateur pertinent. Une variation relative se calcule (nouveau − ancien)/ancien. Distinguer points de pourcentage et variation relative.", "Un absentéisme de 8 % à 10 % augmente de 2 points, soit 25 % en relatif. Vérifier le périmètre et les jours retenus.", "Comparer des taux calculés avec des dénominateurs différents.", "Passer de 20 % à 25 % correspond à combien de points ?", "5 points de pourcentage.", "INSEE, méthodes statistiques."], ["Déontologie et conflits d’intérêts", "Distinguer neutralité, impartialité, probité, secret professionnel et discrétion professionnelle. Un conflit d’intérêts est une interférence susceptible d’influencer ou de paraître influencer l’exercice indépendant d’une fonction.", "Un agent participe à l’achat d’une prestation proposée par un proche : signaler la situation et organiser le déport selon le cadre applicable.", "Limiter le conflit d’intérêts aux seuls cas de corruption avérée.", "Pourquoi signaler un conflit même sans avantage financier ?", "Parce que l’impartialité réelle ou apparente peut être compromise.", "CGFP, art. L121-1 et suivants."], ["Gouvernance de projet", "Définir résultat attendu, périmètre, livrables, responsables, dépendances, risques et jalons. Le COPIL arbitre selon son mandat ; le chef de projet coordonne l’exécution.", "Pour un portail usager, fixer un périmètre pilote, tester l’accessibilité, vérifier sécurité, préparer accompagnement et mesurer adoption.", "Confondre date de livraison et réussite du projet.", "À quoi sert un jalon ?", "À matérialiser une étape de contrôle ou de décision.", "CNFPT, conduite de projet."]];

function pedagogy(){state.ped||={};state.ped.review||={};state.ped.diag||={};return state.ped}
function pedCard(i){const d=deepData[i],c=courses[i];return '<div class="deep"><h4>Approfondissement — '+esc(d[0])+'</h4><p>'+esc(d[1])+'</p><h4>Du cours à la décision</h4><p>'+esc(d[2])+'</p><p class="pitfall"><b>Erreur à éviter :</b> '+esc(d[3])+'</p><p><b>Référence à consulter :</b> '+esc(d[6])+' (voir la source officielle du cours ; vérifier la version applicable).</p><details><summary>Rappel actif : '+esc(d[4])+'</summary><p>'+esc(d[5])+'</p></details><button onclick="pedRate('+i+',false)">À revoir</button> <button onclick="pedRate('+i+',true)">Je sais expliquer</button></div>'}
function pedRate(i,ok){let p=pedagogy(),k=level+':'+i,v=p.review[k]||{stage:0};v.stage=ok?Math.min(5,v.stage+1):0;v.due=Date.now()+([0,1,3,7,14,30][v.stage])*86400000;v.last=ok;p.review[k]=v;save();if(tab==='Révisions actives'||tab==='Parcours guidé')render();else alert('Révision enregistrée.')}
function pedDue(){let p=pedagogy();return deepData.map((d,i)=>i).filter(i=>!p.review[level+':'+i]||p.review[level+':'+i].due<=Date.now())}
function pedView(){let p=pedagogy(),due=pedDue();if(tab==='Parcours guidé'){let done=Object.keys(p.review).filter(k=>k.startsWith(level+':')&&p.review[k].stage>=2).length;return '<section><h3>Ton parcours de formation</h3><p>Travaille 45 à 60 minutes : 10 min de rappel sans notes, 20 min de cours approfondi, 15 min d’application, 10 min de correction. Termine en expliquant la notion à voix haute.</p><div class="grid"><article><b>Notions à réviser aujourd’hui</b><br><output>'+due.length+'</output></article><article><b>Notions consolidées (2 rappels réussis au moins)</b><br><output>'+done+'/20</output></article></div><p>Priorité : droit, finances, économie et rédaction. Le diagnostic ci-dessous distingue les notions à reprendre ; il ne prédit pas la réussite au concours.</p><button onclick="go(\'Diagnostic\')">1. Faire le diagnostic</button> <button onclick="go(\'Cours\')">2. Approfondir</button> <button onclick="go(\'Révisions actives\')">3. Réviser</button> <button onclick="go(\'Coach rédaction\')">4. Rédiger</button></section>'+ '<section><h3>Plan de séance recommandé</h3>'+ (due.length?due.slice(0,3).map(i=>'<p>• '+esc(courses[i][0])+'</p>').join(''):'<p>Révisions à jour. Travaille une annale réelle.</p>')+'</section>'}
if(tab==='Diagnostic')return '<section><h3>Diagnostic de restitution</h3><p>Réponds sans consulter les cours. Révèle ensuite la réponse et évalue ta maîtrise : 0 = inconnue, 1 = partielle, 2 = exacte et expliquée. Auto-évaluation, pas de correction automatique.</p>'+deepData.map((d,i)=>'<article><h4>'+esc(courses[i][0])+'</h4><p>'+esc(d[4])+'</p>'+draft('diag'+i,'Ta réponse')+'<details><summary>Réponse attendue</summary>'+esc(d[5])+'</details><label>Maîtrise <select onchange="pedDiag('+i+',this.value)"><option value="" '+(p.diag[level+':'+i]==null?'selected':'')+'>Non évalué</option>'+[0,1,2].map(n=>'<option value="'+n+'" '+(p.diag[level+':'+i]===n?'selected':'')+'>'+n+'/2</option>').join('')+'</select></label></article>').join('')+'<p id="pedDiagTotal"></p></section>';
if(tab==='Révisions actives')return '<section><h3>Répétition espacée</h3><p>Réponds avant de retourner la carte. Une réussite reporte la prochaine révision à 1, 3, 7, 14 puis 30 jours ; une erreur remet la notion à aujourd’hui.</p>'+ (due.length?due.slice(0,10).map(i=>'<article><h4>'+esc(courses[i][0])+'</h4><p>'+esc(deepData[i][4])+'</p><details><summary>Retourner la carte</summary>'+esc(deepData[i][5])+'<p><button onclick="pedRate('+i+',false)">À revoir</button> <button onclick="pedRate('+i+',true)">Acquis</button></p></details></article>').join(''):'<p>Aucune carte due. Reviens à la prochaine échéance.</p>')+'</section>';
return '<section><h3>Coach rédaction : analyse guidée</h3><p>Choisis un sujet, puis rédige un paragraphe complet. Le repérage automatique indique seulement des indices de structure ; il ne valide ni les faits ni la qualité juridique.</p><label>Sujet <select id="coachTopic">'+courses.map((c,i)=>'<option value="'+i+'">'+esc(c[0])+'</option>').join('')+'</select></label>'+draft('coach','Ton paragraphe argumenté')+'<button class="primary" onclick="coachAnalyse()">Analyser la structure</button><div id="coachResult" aria-live="polite"></div><h4>Grille de relecture</h4><p>1. Affirmation précise. 2. Cause et conséquence. 3. Fondement ou donnée. 4. Solution proportionnée. 5. Acteur, moyen et échéance. 6. Indicateur et limite. Adapter à la commande : une composition n’impose pas un plan d’action.</p></section>'}
function pedDiag(i,v){let p=pedagogy(),k=level+':'+i;if(v==='')delete p.diag[k];else p.diag[k]=Number(v);save();pedDiagTotal()}
function pedDiagTotal(){let el=$('pedDiagTotal');if(!el)return;let p=pedagogy(),a=Object.entries(p.diag).filter(([k])=>k.startsWith(level+':'));el.textContent='Évaluées : '+a.length+'/20 · Points : '+a.reduce((s,[k,v])=>s+v,0)+'/'+(a.length*2)+' · À approfondir : '+a.filter(([k,v])=>v<2).map(([k])=>courses[Number(k.split(':')[1])][0]).join(', ')}
function coachAnalyse(){let t=document.querySelector('[data-key="'+level+'coach"]').value.trim(),i=Number($('coachTopic').value);let checks=[['Justification',/car|parce que|en effet|puisque/i,'Explique pourquoi cette idée répond à la commande.'],['Fondement ou donnée',/article|décret|loi|\d|document|source/i,'Cite une donnée ou un fondement vérifié si pertinent.'],['Conséquence',/donc|ainsi|risque|conséquence|entraîne|effet/i,'Explique les effets de la situation.'],['Action et acteurs',/mettre en|proposer|organiser|pilot|direction|service|responsable/i,'Précise la réponse et le responsable si la commande le demande.'],['Évaluation',/indicateur|bilan|suivi|évalu|mesurer/i,'Précise comment vérifier les résultats si pertinent.']];$('coachResult').innerHTML='<p><b>'+ (t?t.split(/\s+/).length:0)+' mots</b> — indices lexicaux, sans note automatique.</p>'+checks.map(([n,r,m])=>'<p><b>'+n+' : </b>'+(r.test(t)?'Indice repéré — vérifier sa pertinence.':'Non repéré — '+m)+'</p>').join('')+'<details><summary>Exemple de raisonnement à comparer</summary><p>'+esc(deepData[i][2])+'</p><p><b>Erreur fréquente :</b> '+esc(deepData[i][3])+'</p></details>'}

const jOffsets=[0,1,3,7,14,30,60];
function jDay(d=new Date()){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function jAdd(s,n){const [y,m,d]=s.split('-').map(Number);return jDay(new Date(y,m-1,d+n,12))}
function jData(){state.jPlanning=state.jPlanning||{};return state.jPlanning[level]||(state.jPlanning[level]={items:{},start:jDay(),pace:2})}
function jFormat(s){return s.split('-').reverse().join('/')}
function jPlan(){let p=jData();let start=$('jStart').value,pace=Number($('jPace').value);if(!start||!Number.isInteger(pace)||pace<1||pace>20)return alert('Choisis une date et un rythme valide.');p.start=start;p.pace=pace;courses.forEach((c,i)=>{if(!p.items[i])p.items[i]={start:jAdd(start,7*Math.floor(i/pace)+Math.floor((i%pace)*6/pace)),done:{}}});save();render()}
function jSet(i){let s=$('jDate'+i).value;if(!s)return;let p=jData(),old=p.items[i];if(old&&old.start!==s&&Object.keys(old.done).length&&!confirm('Modifier la date J0 efface les validations de ce cours. Continuer ?'))return;p.items[i]={start:s,done:old&&old.start===s?old.done:{}};save();render()}
function jMark(i,n){let item=jData().items[i];if(!item)return;if(item.done[n]){delete item.done[n]}else{item.done[n]=jDay()}save();render()}
function jView(){let p=jData(),today=jDay(),tasks=[];for(const [i,item] of Object.entries(p.items)){for(const n of jOffsets){let date=jAdd(item.start,n);if(!item.done[n])tasks.push({i:+i,n,date})}}tasks.sort((a,b)=>a.date.localeCompare(b.date)||a.i-b.i);let due=tasks.filter(t=>t.date<=today),next=tasks.filter(t=>t.date>today&&t.date<=jAdd(today,7));const rows=a=>a.length?a.map(t=>'<div class="jtask"><b>'+esc(courses[t.i][0])+'</b><span>J'+t.n+' · '+jFormat(t.date)+(t.date<today?' · En retard':'')+'</span><button onclick="jMark('+t.i+','+t.n+')">Valider</button></div>').join(''):'<p>Aucune échéance.</p>';let done=Object.values(p.items).reduce((s,x)=>s+Object.keys(x.done).length,0);return '<section><h3>Méthode des J — planning de mémorisation</h3><p>J0 : apprendre et comprendre. J1 : restituer sans notes. J3 : expliquer avec un exemple. J7 : appliquer à un cas. J14 : rédiger un argument. J30 : tester sans aide. J60 : consolider. Ce calendrier est une variante pédagogique, pas un protocole médical standard.</p><div class="jflow">'+jOffsets.map(n=>'<span>J'+n+'</span>').join('')+'</div><p>À chaque rappel, ferme le cours, réponds de mémoire, puis vérifie. Si tu échoues, reprends la notion demain avant de valider. Une validation signifie que tu sais restituer la notion ; les dates restent ancrées sur J0.</p><label>Début du programme <input type="date" id="jStart" value="'+esc(p.start)+'"></label><label>Nouveaux cours par semaine <input type="number" min="1" max="20" id="jPace" value="'+p.pace+'"></label><button class="primary" onclick="jPlan()">Planifier les cours non programmés</button><p>Les cours déjà planifiés et leurs validations sont conservés. Planning distinct pour chaque concours.</p></section><div class="grid"><article>À faire aujourd’hui / en retard<br><output>'+due.length+'</output></article><article>Dans les 7 prochains jours<br><output>'+next.length+'</output></article><article>Révisions validées<br><output>'+done+'/'+(Object.keys(p.items).length*jOffsets.length)+'</output></article></div><section><h3>Mes révisions à effectuer</h3>'+rows(due)+'<button onclick="go(\'Révisions actives\')">Ouvrir les cartes de révision</button></section><section><h3>Prochaines échéances (7 jours)</h3>'+rows(next)+'</section><section><h3>Calendrier complet par cours</h3><p>Choisis une date J0 ou utilise la planification automatique. Clique sur une échéance pour la valider ou annuler sa validation.</p>'+courses.map((c,i)=>{let item=p.items[i];return '<article><h4>'+esc(c[0])+'</h4><label>J0 <input type="date" id="jDate'+i+'" value="'+(item?esc(item.start):'')+'"></label><button onclick="jSet('+i+')">Enregistrer J0</button>'+(item?'<div class="jdates">'+jOffsets.map(n=>{let d=jAdd(item.start,n),ok=item.done[n];return '<button class="'+(ok?'jdone':d<today?'jlate':d===today?'jtoday':'')+'" onclick="jMark('+i+','+n+')" '+(!ok&&d>today?'disabled':'')+' aria-pressed="'+!!ok+'">J'+n+'<br>'+jFormat(d)+'<br>'+(ok?'✓ Validé':d<today?'En retard':d===today?'Aujourd’hui':'À venir')+'</button>'}).join('')+'</div>':'<p>Non programmé</p>')+'</article>'}).join('')+'</section>'}

render();</script></body></html>
